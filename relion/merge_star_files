#!/apps/strubi/software/packages/miniforge3/envs/miss-alignment/bin/python
"""
merge_star_files

Merge selected STAR files generated by split_star_by_tomo (or other
compatible RELION STAR files) without changing particle metadata.

- Append rows from the particle table, retaining the input-file order.
- Require identical particle column names (column order may differ).
- Preserve non-particle blocks (e.g. data_optics) only if they agree.
- Never overwrite the output unless --overwrite is supplied.

Example:
    merge_star_files --input by_tomo/L3_pos01_ts_004.star by_tomo/L3_pos01_ts_007.star by_tomo/L3_pos01_ts_006.star --output merged_L3.star

Developed and maintained by Long Chen.
"""

from __future__ import annotations

import argparse
from pathlib import Path

import pandas as pd
import starfile


GROUPING_COLUMNS = ("rlntomoname", "rlnmicrographname")


def find_grouping_column(df: pd.DataFrame) -> str | None:
    """Find the tomogram/micrograph column used by split_star_by_tomo."""
    for candidate in GROUPING_COLUMNS:
        for column in df.columns:
            if str(column).lstrip("_").lower() == candidate:
                return str(column)
    return None


def find_particle_block(
    blocks: dict, requested_block: str | None = None
) -> tuple[str, pd.DataFrame, str]:
    """Find exactly one particle table, unless --block selects one."""
    if requested_block is not None:
        if requested_block not in blocks:
            raise ValueError(
                f"STAR block '{requested_block}' not found. "
                f"Available blocks: {', '.join(blocks)}"
            )
        names = [requested_block]
    else:
        names = list(blocks)

    matches = []
    for name in names:
        data = blocks[name]
        if isinstance(data, pd.DataFrame):
            group_column = find_grouping_column(data)
            if group_column is not None:
                matches.append((name, data, group_column))

    if not matches:
        raise ValueError(
            "Could not find a particle table with rlnTomoName or "
            "rlnMicrographName. Use --block if necessary."
        )
    if len(matches) > 1:
        raise ValueError(
            "More than one possible particle block: "
            + ", ".join(name for name, _, _ in matches)
            + ". Use --block BLOCK_NAME."
        )
    return matches[0]


def check_other_blocks(reference: dict, candidate: dict, input_path: Path,
                       particle_block: str) -> None:
    """Ensure additional blocks can be retained without corrupting metadata."""
    if set(reference) != set(candidate):
        raise ValueError(
            f"{input_path}: STAR block names differ from the first input.\n"
            f"Expected: {sorted(reference)}\nFound: {sorted(candidate)}"
        )

    for name, first in reference.items():
        if name == particle_block:
            continue

        other = candidate[name]
        if isinstance(first, pd.DataFrame) and isinstance(other, pd.DataFrame):
            if set(first.columns) != set(other.columns):
                raise ValueError(
                    f"{input_path}: columns in non-particle block "
                    f"'{name}' differ. Cannot safely preserve this block."
                )
            try:
                pd.testing.assert_frame_equal(
                    first,
                    other.loc[:, first.columns],
                    check_dtype=False,
                    check_exact=True,
                )
            except AssertionError as exc:
                raise ValueError(
                    f"{input_path}: non-particle block '{name}' differs "
                    "from the first input (possibly different optics "
                    "groups). Refusing to merge without explicit mapping."
                ) from exc
        elif isinstance(first, pd.DataFrame) != isinstance(other, pd.DataFrame):
            raise ValueError(f"{input_path}: block '{name}' has a different type.")
        elif first != other:
            raise ValueError(
                f"{input_path}: non-particle block '{name}' differs "
                "from the first input."
            )


def merge_star_files(
    input_files: list[Path],
    output_file: Path,
    block_name: str | None = None,
    overwrite: bool = False,
) -> None:
    """Merge compatible particle tables while preserving all STAR blocks."""
    if len(input_files) < 2:
        raise ValueError("Provide at least two input STAR files with --input.")

    resolved_inputs = [path.expanduser().resolve() for path in input_files]
    if len(set(resolved_inputs)) != len(resolved_inputs):
        raise ValueError("The input list contains the same file more than once.")

    output_file = output_file.expanduser().resolve()
    if output_file in resolved_inputs:
        raise ValueError("Output cannot be one of the input files.")
    if output_file.exists() and not overwrite:
        raise FileExistsError(
            f"Output already exists: {output_file}\nUse --overwrite to replace it."
        )

    reference_blocks = None
    reference_columns = None
    reference_group_column = None
    reference_block_name = None
    particle_tables = []
    counts = []

    for path in resolved_inputs:
        if not path.is_file():
            raise FileNotFoundError(f"Input STAR file not found: {path}")

        blocks = starfile.read(path, always_dict=True)
        name, particles, group_column = find_particle_block(blocks, block_name)

        if reference_blocks is None:
            reference_blocks = blocks
            reference_block_name = name
            reference_columns = list(particles.columns)
            reference_group_column = group_column
            if len(reference_columns) != len(set(reference_columns)):
                raise ValueError(f"{path}: duplicate particle column names.")
        else:
            if name != reference_block_name:
                raise ValueError(
                    f"{path}: particle block '{name}' differs from "
                    f"'{reference_block_name}' in the first input."
                )
            check_other_blocks(reference_blocks, blocks, path, reference_block_name)
            if len(particles.columns) != len(set(particles.columns)):
                raise ValueError(f"{path}: duplicate particle column names.")
            if set(particles.columns) != set(reference_columns):
                missing = sorted(set(reference_columns) - set(particles.columns))
                extra = sorted(set(particles.columns) - set(reference_columns))
                raise ValueError(
                    f"{path}: particle columns are incompatible.\n"
                    f"Missing: {missing}\nExtra: {extra}"
                )
            if group_column != reference_group_column:
                raise ValueError(
                    f"{path}: grouping column differs: "
                    f"'{group_column}' vs '{reference_group_column}'."
                )

        if particles[group_column].isna().any() or (
            particles[group_column].astype(str).str.strip() == ""
        ).any():
            raise ValueError(f"{path}: missing/empty {group_column} values.")

        # Reorder by names (not by column positions); do not modify values.
        particle_tables.append(particles.loc[:, reference_columns].copy())
        counts.append((path, len(particles)))

    merged = pd.concat(particle_tables, ignore_index=True)
    assert reference_blocks is not None
    assert reference_block_name is not None
    assert reference_group_column is not None
    assert sum(count for _, count in counts) == len(merged)

    # Reuse original optics/other metadata; replace only the particle block.
    output_blocks = dict(reference_blocks)
    output_blocks[reference_block_name] = merged

    output_file.parent.mkdir(parents=True, exist_ok=True)
    starfile.write(output_blocks, output_file, overwrite=overwrite)

    print("\nInput STAR files:")
    for path, count in counts:
        print(f"  {path.name}: {count} particles")
    print(f"\nParticle block: {reference_block_name}")
    print(f"Grouping column: {reference_group_column}")
    print(f"Tomograms/micrographs: {merged[reference_group_column].nunique()}")
    print(f"Total particles: {len(merged)}")
    print(f"Output STAR: {output_file}\n")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Merge compatible STAR files while preserving other blocks."
    )
    parser.add_argument(
        "--input", nargs="+", type=Path, required=True, metavar="FILE.star",
        help="Two or more input STAR files (in the desired particle order).",
    )
    parser.add_argument(
        "-o", "--output", type=Path, required=True,
        help="Output STAR file.",
    )
    parser.add_argument(
        "--block", default=None,
        help="Explicit name of the particle block (normally auto-detected).",
    )
    parser.add_argument(
        "--overwrite", action="store_true",
        help="Allow overwriting an existing output STAR file.",
    )
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    try:
        merge_star_files(args.input, args.output, args.block, args.overwrite)
    except (OSError, ValueError, RuntimeError) as exc:
        raise SystemExit(f"ERROR: {exc}") from exc


if __name__ == "__main__":
    main()
