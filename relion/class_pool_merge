class JobConfig:
    """Configuration for a single RELION Class3D job."""

    name: str
    star: Path
    k: int
    classes: dict[str, list[int]]
    input_pool: str | None = None
    input_star: Path | None = None
    model_star: Path | None = None
    expected_particles: int | None = None
    note: str | None = None


@dataclass(frozen=True)
class MergeConfig:
    """Validated top-level configuration for class_pool_merge."""

    round_label: str
    round_prefix: str
    project_dir: Path
    output_dir: Path
    pools: tuple[str, ...]
    jobs: dict[str, JobConfig]
    frozen: dict[str, FrozenPoolConfig] = field(default_factory=dict)
    previous_round: str | None = None
    previous_provenance: Path | None = None
    id_column: str | tuple[str, ...] = "auto"
    expected_total: int | None = None


