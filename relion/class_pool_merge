def normalize_round_label(value: Any, field_name: str = "round") -> tuple[str, str]:
    """Normalize a round identifier into (display_label, lowercase_prefix)."""
    if isinstance(value, bool) or value is None:
        raise ValueError(f"Configuration field '{field_name}' must be a string or integer.")

    if isinstance(value, int):
        if value < 1:
            raise ValueError(f"Configuration field '{field_name}' must be >= 1, got {value}.")
        label = f"Round{value}"
        return label, label.lower()

    if isinstance(value, str):
        text = value.strip()
        if not text:
            raise ValueError(f"Configuration field '{field_name}' cannot be empty.")
        if text.isdigit():
            num = int(text)
            if num < 1:
                raise ValueError(f"Configuration field '{field_name}' must be >= 1, got {value!r}.")
            label = f"Round{num}"
            return label, label.lower()
        if not SAFE_NAME_RE.fullmatch(text):
            raise ValueError(
                f"Configuration field '{field_name}' contains unsafe characters: {value!r}"
            )
        return text, text.lower()

    raise ValueError(
        f"Configuration field '{field_name}' must be a string or integer, got {type(value).__name__}."
    )


def parse_positive_int(value: Any, context: str, allow_zero: bool = False) -> int:
    """Validate an integer configuration field."""
    if isinstance(value, bool) or not isinstance(value, int):
        raise ValueError(f"{context} must be an integer, got {value!r}.")
    minimum = 0 if allow_zero else 1
    if value < minimum:
        raise ValueError(f"{context} must be >= {minimum}, got {value}.")
    return value


def parse_class_spec(spec: Any, context: str = "class specification") -> list[int]:
    """
    Parse a class assignment specification into a sorted list of unique class IDs.

    Supported formats:
        - list of integers: [1, 2, 5, 8]
        - compact range string: "1-5, 7, 9-12" or ""
    """
    if spec is None:
        raise ValueError(f"{context}: class assignment cannot be None.")

    numbers: list[int] = []

    if isinstance(spec, list):
        for item in spec:
            if isinstance(item, bool) or not isinstance(item, int):
                raise ValueError(
                    f"{context}: class list elements must be integers, got {item!r}."
                )
            if item < 1:
                raise ValueError(
                    f"{context}: class numbers must be >= 1, got {item}."
                )
            numbers.append(item)
    elif isinstance(spec, str):
        text = spec.strip()
        if not text:
            return []
        tokens = [tok.strip() for tok in text.split(",")]
        if any(tok == "" for tok in tokens):
            raise ValueError(
                f"{context}: malformed class range syntax (empty token) in {spec!r}."
            )
        for token in tokens:
            match = RANGE_TOKEN_RE.fullmatch(token)
            if match is None:
                raise ValueError(
                    f"{context}: invalid class range token {token!r} in {spec!r}."
                )
            start = int(match.group(1))
            end_str = match.group(2)
            end = int(end_str) if end_str is not None else start
            if start < 1 or end < 1:
                raise ValueError(
                    f"{context}: class numbers must be >= 1 in token {token!r}."
                )
            if end < start:
                raise ValueError(
                    f"{context}: descending class range {token!r} is not allowed (start > end)."
                )
            numbers.extend(range(start, end + 1))
    else:
        raise ValueError(
            f"{context}: expected a list of integers or range string, got {type(spec).__name__}."
        )

    seen: set[int] = set()
    duplicates: list[int] = []
    for num in numbers:
        if num in seen and num not in duplicates:
            duplicates.append(num)
        seen.add(num)

    if duplicates:
        raise ValueError(
            f"{context}: duplicate class numbers in specification: {sorted(duplicates)}"
        )

    return numbers


def resolve_config_path(raw_path: Any, base_dir: Path, context: str) -> Path:
    """Validate a non-empty path string and resolve relative to base_dir."""
    if not isinstance(raw_path, str) or not raw_path.strip():
        raise ValueError(f"{context} must be a non-empty path string.")
    path = Path(raw_path.strip()).expanduser()
    return path if path.is_absolute() else (base_dir / path)


def parse_pools(raw_pools: Any) -> tuple[str, ...]:
    """Validate ordered list of unique output pool names."""
    if not isinstance(raw_pools, list) or not raw_pools:
        raise ValueError("Configuration field 'pools' must be a non-empty list of pool names.")

    pools: list[str] = []
    seen: set[str] = set()
    duplicates: list[str] = []

    for item in raw_pools:
        if not isinstance(item, str) or not item.strip():
            raise ValueError("Every pool name in 'pools' must be a non-empty string.")
        name = item.strip()
        if not SAFE_NAME_RE.fullmatch(name):
            raise ValueError(f"Pool name {name!r} contains invalid characters.")
        if name in seen:
            if name not in duplicates:
                duplicates.append(name)
        seen.add(name)
        pools.append(name)

    if duplicates:
        raise ValueError(f"Duplicate pool names in 'pools': {duplicates}")

    return tuple(pools)


def parse_frozen_pools(
    raw_frozen: Any,
    pools: tuple[str, ...],
    project_dir: Path,
    prev_round_label: str | None,
) -> dict[str, FrozenPoolConfig]:
    """Validate optional [frozen.<Pool>] sections."""
    if raw_frozen is None:
        return {}
    if not isinstance(raw_frozen, dict):
        raise ValueError("Configuration section 'frozen' must be a table.")

    valid_pools = set(pools)
    frozen_configs: dict[str, FrozenPoolConfig] = {}

    for pool_name, entry in raw_frozen.items():
        if pool_name not in valid_pools:
            raise ValueError(
                f"Frozen pool {pool_name!r} is not declared in 'pools' ({list(pools)})."
            )
        if not isinstance(entry, dict):
            raise ValueError(f"frozen.{pool_name} must be a table.")

        if "star" not in entry:
            raise ValueError(f"frozen.{pool_name} is missing required field 'star'.")
        star_path = resolve_config_path(
            entry["star"], project_dir, f"frozen.{pool_name}.star"
        )

        mode = entry.get("mode", "copy_only")
        if not isinstance(mode, str) or mode not in VALID_FROZEN_MODES:
            raise ValueError(
                f"frozen.{pool_name}.mode must be one of {list(VALID_FROZEN_MODES)}, got {mode!r}."
            )

        expected_raw = entry.get("expected_particles", entry.get("expected"))
        expected_particles = (
            parse_positive_int(expected_raw, f"frozen.{pool_name}.expected_particles", allow_zero=True)
            if expected_raw is not None
            else None
        )

        default_label = (
            f"FROZEN_{prev_round_label.upper()}" if prev_round_label else f"FROZEN_{pool_name.upper()}"
        )
        source_label = entry.get("source_label", default_label)
        if not isinstance(source_label, str) or not source_label.strip():
            raise ValueError(f"frozen.{pool_name}.source_label must be a non-empty string.")

        frozen_configs[pool_name] = FrozenPoolConfig(
            pool=pool_name,
            star=star_path,
            mode=mode,
            expected_particles=expected_particles,
            source_label=source_label.strip(),
        )

    return frozen_configs


def parse_jobs(
    raw_jobs: Any,
    pools: tuple[str, ...],
    frozen: dict[str, FrozenPoolConfig],
    project_dir: Path,
) -> dict[str, JobConfig]:
    """Validate [jobs.<JobName>] sections and enforce strict 1..K class partitioning."""
    if not isinstance(raw_jobs, dict) or not raw_jobs:
        raise ValueError("Configuration must define a non-empty 'jobs' table.")

    valid_pools = set(pools)
    jobs: dict[str, JobConfig] = {}

    for job_name, entry in raw_jobs.items():
        if not isinstance(job_name, str) or not job_name.strip():
            raise ValueError("Job names in 'jobs' must be non-empty strings.")
        if not isinstance(entry, dict):
            raise ValueError(f"jobs.{job_name} must be a table.")

        if "star" not in entry:
            raise ValueError(f"jobs.{job_name} is missing required field 'star'.")
        star_path = resolve_config_path(
            entry["star"], project_dir, f"jobs.{job_name}.star"
        )

        if "k" not in entry:
            raise ValueError(f"jobs.{job_name} is missing required field 'k' (number of classes).")
        k = parse_positive_int(entry["k"], f"jobs.{job_name}.k")

        expected_raw = entry.get("expected_particles", entry.get("expected"))
        expected_particles = (
            parse_positive_int(expected_raw, f"jobs.{job_name}.expected_particles")
            if expected_raw is not None
            else None
        )

        input_pool = entry.get("input_pool")
        if input_pool is not None:
            if not isinstance(input_pool, str) or not input_pool.strip():
                raise ValueError(f"jobs.{job_name}.input_pool must be a non-empty string.")
            input_pool = input_pool.strip()

        input_star = (
            resolve_config_path(entry["input_star"], project_dir, f"jobs.{job_name}.input_star")
            if "input_star" in entry and entry["input_star"] is not None
            else None
        )

        model_star = (
            resolve_config_path(entry["model_star"], project_dir, f"jobs.{job_name}.model_star")
            if "model_star" in entry and entry["model_star"] is not None
            else None
        )

        note = entry.get("note")
        if note is not None and not isinstance(note, str):
            raise ValueError(f"jobs.{job_name}.note must be a string.")

        raw_classes = entry.get("classes")
        if not isinstance(raw_classes, dict) or not raw_classes:
            raise ValueError(
                f"jobs.{job_name} must define a non-empty 'classes' table mapping pools to classes."
            )

        unknown_pools = [p for p in raw_classes if p not in valid_pools]
        if unknown_pools:
            raise ValueError(
                f"jobs.{job_name}.classes references unknown target pool(s) {unknown_pools}; "
                f"valid pools are {list(pools)}."
            )

        parsed_classes: dict[str, list[int]] = {}
        for pool_name in pools:
            if pool_name in raw_classes:
                class_list = parse_class_spec(
                    raw_classes[pool_name],
                    context=f"jobs.{job_name}.classes.{pool_name}",
                )
            else:
                class_list = []

            if class_list and pool_name in frozen and frozen[pool_name].mode == "copy_only":
                raise ValueError(
                    f"jobs.{job_name}.classes.{pool_name}: pool {pool_name!r} is configured as "
                    f"frozen with mode='copy_only' and cannot accept new class assignments "
                    f"({class_list}). Set mode='append' explicitly if additions are intended."
                )

            parsed_classes[pool_name] = class_list

        # Validate complete, mutually exclusive partitioning of 1..K.
        assigned_all: list[int] = []
        class_to_pools: dict[int, list[str]] = {}
        for pool_name, class_list in parsed_classes.items():
            for cls_id in class_list:
                assigned_all.append(cls_id)
                class_to_pools.setdefault(cls_id, []).append(pool_name)

        out_of_range = sorted(c for c in set(assigned_all) if c < 1 or c > k)
        if out_of_range:
            raise ValueError(
                f"jobs.{job_name}: class numbers out of range 1..{k}: {out_of_range}"
            )

        duplicate_classes = {
            c: pool_list for c, pool_list in class_to_pools.items() if len(pool_list) > 1
        }
        if duplicate_classes:
            details = ", ".join(
                f"class {c} in {pool_list}" for c, pool_list in sorted(duplicate_classes.items())
            )
            raise ValueError(
                f"jobs.{job_name}: duplicate class assignments across pools ({details})."
            )

        expected_set = set(range(1, k + 1))
        assigned_set = set(assigned_all)
        missing_classes = sorted(expected_set - assigned_set)
        if missing_classes:
            raise ValueError(
                f"jobs.{job_name}: missing class assignments for K={k}: {missing_classes}. "
                f"Every class from 1 to {k} must be assigned to exactly one pool."
            )

        jobs[job_name] = JobConfig(
            name=job_name,
            star=star_path,
            k=k,
            classes=parsed_classes,
            input_pool=input_pool,
            input_star=input_star,
            model_star=model_star,
            expected_particles=expected_particles,
            note=note,
        )

    return jobs


def parse_id_column(raw_id_col: Any) -> str | tuple[str, ...]:
    """Validate optional id_column specification."""
    if raw_id_col is None:
        return "auto"
    if isinstance(raw_id_col, str):
        text = raw_id_col.strip()
        if not text:
            raise ValueError("Configuration field 'id_column' cannot be empty.")
        return text
    if isinstance(raw_id_col, list) and raw_id_col:
        cols: list[str] = []
        for item in raw_id_col:
            if not isinstance(item, str) or not item.strip():
                raise ValueError("Elements of 'id_column' must be non-empty strings.")
            cols.append(item.strip())
        if len(set(cols)) != len(cols):
            raise ValueError(f"Duplicate column names in 'id_column': {cols}")
        return tuple(cols)
    raise ValueError("Configuration field 'id_column' must be a string or non-empty list of strings.")


def load_config(
    config_path: Path,
    project_dir_override: Path | None = None,
    outdir_override: Path | None = None,
) -> MergeConfig:
    """Read and validate a TOML configuration file for class_pool_merge."""
    if not config_path.exists():
        raise FileNotFoundError(f"Configuration file does not exist: {config_path}")
    if not config_path.is_file():
        raise ValueError(f"Configuration path is not a file: {config_path}")

    raw_bytes = config_path.read_bytes()
    try:
        data = tomllib.loads(raw_bytes.decode("utf-8"))
    except (UnicodeDecodeError, tomllib.TOMLDecodeError) as exc:
        raise ValueError(f"Failed to parse TOML configuration {config_path}: {exc}") from exc

    if "round" not in data:
        raise ValueError("Configuration is missing required field 'round'.")
    round_label, round_prefix = normalize_round_label(data["round"], "round")

    previous_round: str | None = None
    if "previous_round" in data and data["previous_round"] is not None:
        previous_round, _ = normalize_round_label(data["previous_round"], "previous_round")

    if project_dir_override is not None:
        project_dir = project_dir_override.expanduser().resolve()
    elif "project_dir" in data and data["project_dir"] is not None:
        if not isinstance(data["project_dir"], str) or not data["project_dir"].strip():
            raise ValueError("Configuration field 'project_dir' must be a non-empty path string.")
        project_dir = Path(data["project_dir"].strip()).expanduser().resolve()
    else:
        project_dir = Path(".").resolve()

    if outdir_override is not None:
        raw_out = outdir_override.expanduser()
        output_dir = raw_out if raw_out.is_absolute() else (project_dir / raw_out)
    elif "output_dir" in data and data["output_dir"] is not None:
        output_dir = resolve_config_path(data["output_dir"], project_dir, "output_dir")
    else:
        output_dir = project_dir / f"{round_label}_split"

    if "pools" not in data:
        raise ValueError("Configuration is missing required field 'pools'.")
    pools = parse_pools(data["pools"])

    frozen = parse_frozen_pools(
        data.get("frozen"),
        pools=pools,
        project_dir=project_dir,
        prev_round_label=previous_round,
    )

    if "jobs" not in data:
        raise ValueError("Configuration is missing required section 'jobs'.")
    jobs = parse_jobs(
        data["jobs"],
        pools=pools,
        frozen=frozen,
        project_dir=project_dir,
    )

    expected_total: int | None = None
    if "expected_total" in data and data["expected_total"] is not None:
        expected_total = parse_positive_int(data["expected_total"], "expected_total")

    # If expected_total and all source expected_particles are specified, verify their sum matches.
    all_sources_have_expected = all(
        f.expected_particles is not None for f in frozen.values()
    ) and all(j.expected_particles is not None for j in jobs.values())

    if expected_total is not None and all_sources_have_expected:
        source_sum = sum(f.expected_particles or 0 for f in frozen.values()) + sum(
            j.expected_particles or 0 for j in jobs.values()
        )
        if source_sum != expected_total:
            raise ValueError(
                f"Sum of expected_particles across frozen pools and jobs ({source_sum:,}) "
                f"does not match expected_total ({expected_total:,})."
            )

    previous_provenance = (
        resolve_config_path(data["previous_provenance"], project_dir, "previous_provenance")
        if "previous_provenance" in data and data["previous_provenance"] is not None
        else None
    )

    id_column = parse_id_column(data.get("id_column"))

    return MergeConfig(
        round_label=round_label,
        round_prefix=round_prefix,
        project_dir=project_dir,
        output_dir=output_dir,
        pools=pools,
        jobs=jobs,
        frozen=frozen,
        previous_round=previous_round,
        previous_provenance=previous_provenance,
        id_column=id_column,
        expected_total=expected_total,
        config_sha256=hashlib.sha256(raw_bytes).hexdigest(),
    )


def derive_model_star_path(jcfg: JobConfig) -> Path:
    """Resolve the model STAR path for a Class3D job configuration."""
    if jcfg.model_star is not None:
        return jcfg.model_star
    name = jcfg.star.name
    if name.endswith("_data.star"):
        return jcfg.star.with_name(name[:-len("_data.star")] + "_model.star")
    raise ValueError(
        f"jobs.{jcfg.name}: cannot derive model STAR path from {jcfg.star.name!r}; "
        f"expected '*_data.star' or explicit 'model_star' in configuration."
    )


def parse_model_star(model_path: Path) -> ModelStarInfo:
    """
    Read a RELION Class3D run_it*_model.star file to extract K, class indices,
    and _rlnClassDistribution (including zero-particle classes).
    """
    if not model_path.exists():
        raise FileNotFoundError(f"Missing RELION model STAR file: {model_path}")
    if not model_path.is_file():
        raise ValueError(f"Expected a model STAR file but found directory: {model_path}")

    lines = model_path.read_text(encoding="utf-8", errors="replace").splitlines()
    nr_classes_general: int | None = None
    for raw_line in lines:
        stripped = raw_line.strip()
        if stripped.startswith("_rlnNrClasses"):
            parts = stripped.split()
            if len(parts) >= 2:
                try:
                    nr_classes_general = int(parts[1])
                except ValueError as exc:
                    raise ValueError(
                        f"{model_path}: invalid _rlnNrClasses value {parts[1]!r}."
                    ) from exc
            break

    index = 0
    class_rows: list[dict[str, str]] = []
    while index < len(lines):
        if lines[index].strip() != "loop_":
            index += 1
            continue

        index += 1
        headers: list[str] = []
        while index < len(lines):
            line = lines[index].strip()
            if not line or line.startswith("#"):
                index += 1
                continue
            if line.startswith("_"):
                headers.append(line.split()[0])
                index += 1
                continue
            break

        required_headers = {"_rlnReferenceImage", "_rlnClassDistribution"}
        if not required_headers.issubset(headers):
            continue

        rows: list[dict[str, str]] = []
        while index < len(lines):
            line = lines[index].strip()
            if not line:
                if rows:
                    break
                index += 1
                continue
            if line.startswith("#"):
                index += 1
                continue
            if line == "loop_" or line.startswith("data_") or line.startswith("_"):
                break
            try:
                values = shlex.split(line)
            except ValueError as exc:
                raise ValueError(
                    f"{model_path}: malformed row in data_model_classes loop: {line!r}"
                ) from exc
            if len(values) < len(headers):
                raise ValueError(
                    f"{model_path}: incomplete row in data_model_classes loop: {line!r}"
                )
            rows.append(dict(zip(headers, values[: len(headers)])))
            index += 1

        if rows:
            class_rows = rows
            break

    if not class_rows:
        raise ValueError(
            f"{model_path}: could not find class model loop with "
            f"_rlnReferenceImage and _rlnClassDistribution."
        )

    distributions: dict[int, float] = {}
    for row in class_rows:
        ref_image = row["_rlnReferenceImage"]
        match = MODEL_CLASS_RE.search(ref_image)
        if match is None:
            raise ValueError(
                f"{model_path}: could not parse class number from "
                f"_rlnReferenceImage {ref_image!r}."
            )
        class_num = int(match.group(1))
        if class_num < 1:
            raise ValueError(
                f"{model_path}: invalid class number {class_num} in {ref_image!r}."
            )
        if class_num in distributions:
            raise ValueError(
                f"{model_path}: duplicate class number {class_num} in model loop."
            )

        raw_dist = row["_rlnClassDistribution"]
        try:
            dist = float(raw_dist)
        except ValueError as exc:
            raise ValueError(
                f"{model_path}: invalid _rlnClassDistribution {raw_dist!r} "
                f"for class {class_num}."
            ) from exc
        if math.isnan(dist) or math.isinf(dist) or dist < 0.0:
            raise ValueError(
                f"{model_path}: invalid _rlnClassDistribution {dist} for class {class_num}."
            )
        distributions[class_num] = dist

    k_model = len(distributions)
    expected_classes = set(range(1, k_model + 1))
    if set(distributions.keys()) != expected_classes:
        raise ValueError(
            f"{model_path}: model classes {sorted(distributions.keys())} do not form "
            f"a contiguous 1..{k_model} range."
        )

    if nr_classes_general is not None and nr_classes_general != k_model:
        raise ValueError(
            f"{model_path}: _rlnNrClasses ({nr_classes_general}) disagrees with "
            f"number of class entries ({k_model}) in data_model_classes."
        )

    empty_classes = tuple(sorted(c for c, d in distributions.items() if d == 0.0))
    return ModelStarInfo(
        path=model_path,
        k=k_model,
        distributions=distributions,
        empty_classes=empty_classes,
    )


def check_particle_token_syntax(star_path: Path) -> None:
    """Reject duplicate blocks and particle tokens the STAR reader can alter.

    Duplicate blocks silently replace earlier blocks in the installed reader.
    Embedded quotes are altered and unquoted hashes are truncated by the reader.
    Ordinary outer quoting, comments and quoted hashes are supported. Multiline
    semicolon-delimited particle values are outside this table reader's scope.
    """
    in_particles = False
    in_multiline_metadata = False
    seen_blocks: set[str] = set()
    with star_path.open(encoding="utf-8") as stream:
        for line_number, line in enumerate(stream, start=1):
            stripped = line.strip()
            if line.startswith(";"):
                if in_particles:
                    raise ValueError(
                        f"{star_path}: unsupported multiline particle value at line {line_number}; "
                        "use single-line STAR tokens for exact identity validation."
                    )
                in_multiline_metadata = not in_multiline_metadata
                continue
            if in_multiline_metadata:
                continue
            if stripped.startswith("data_"):
                block_name = stripped.split()[0]
                if block_name in seen_blocks:
                    raise ValueError(
                        f"{star_path}: duplicate STAR block {block_name!r} at line {line_number}; "
                        "earlier particles or metadata could otherwise be silently discarded."
                    )
                seen_blocks.add(block_name)
                in_particles = block_name == "data_particles"
                continue
            if not in_particles or not stripped or stripped.startswith(("#", "_", "loop_")):
                continue
            quote: str | None = None
            for index, char in enumerate(line):
                at_boundary = index == 0 or line[index - 1].isspace()
                if char in ("'", '"'):
                    if quote is None and at_boundary:
                        quote = char
                    elif char == quote and (index + 1 == len(line) or line[index + 1].isspace()):
                        quote = None
                    else:
                        raise ValueError(
                            f"{star_path}: embedded quote in a particle token at line {line_number}; "
                            "the STAR parser cannot preserve these values reliably."
                        )
                elif char == "#" and quote is None:
                    if at_boundary:
                        break
                    raise ValueError(
                        f"{star_path}: unquoted '#' inside a particle token at line {line_number}; "
                        "quote the whole token to prevent STAR parser truncation."
                    )


def read_data_star(
    star_path: Path,
    *,
    require_class_numbers: bool = True,
    id_columns: tuple[str, ...] = (),
    allow_empty: bool = False,
) -> tuple[dict[str, Any], pd.DataFrame]:
    """Read a particles table, preserving all potential identity columns as text.

    Previous inputs and frozen pools need no class assignments. Explicit columns
    must be supplied before parsing so numeric-looking IDs retain their spelling.
    """
    if not star_path.exists():
        raise FileNotFoundError(f"Missing RELION data STAR file: {star_path}")
    if not star_path.is_file():
        raise ValueError(f"Expected a STAR file but found directory: {star_path}")

    check_particle_token_syntax(star_path)
    try:
        blocks = starfile.read(
            star_path,
            always_dict=True,
            parse_as_string=list(dict.fromkeys([*STRING_ID_COLUMNS, *id_columns])),
        )
    except Exception as exc:
        raise ValueError(f"Failed to parse STAR file {star_path}: {exc}") from exc

    if not isinstance(blocks, dict) or "particles" not in blocks:
        raise ValueError(f"{star_path}: missing 'particles' (data_particles) block.")

    particles = blocks["particles"]
    if not isinstance(particles, pd.DataFrame):
        raise ValueError(f"{star_path}: 'particles' block is not a valid table.")
    if len(particles) == 0 and not allow_empty:
        raise ValueError(f"{star_path}: 'particles' table is empty (0 rows).")
    if len(particles) == 0:
        # Some starfile releases omit column labels for header-only loop tables.
        columns = []
        in_particles = False
        for line in star_path.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if line.startswith("data_"):
                if in_particles:
                    break
                in_particles = line.split()[0] == "data_particles"
            elif in_particles and line.startswith("_"):
                columns.append(line.split()[0][1:])
        if len(columns) == len(particles.columns):
            particles.columns = columns
    if not particles.columns.is_unique:
        raise ValueError(f"{star_path}: duplicate particle column names.")
    if require_class_numbers and "rlnClassNumber" not in particles.columns:
        raise ValueError(f"{star_path}: missing required column 'rlnClassNumber'.")

    return blocks, particles


def select_identity_columns(
    selection: str | tuple[str, ...],
    sources: dict[str, pd.DataFrame],
) -> tuple[str, ...]:
    """Select one common schema without assuming a candidate's workflow stability.

    Auto selection uses column presence only, never retries another identity when
    duplicate or invalid values are encountered. Explicit selection is required
    for ambiguous schemas and for coordinate-based identities.
    """
    if selection != "auto":
        return (selection,) if isinstance(selection, str) else selection

    candidates = [
        columns for columns in AUTO_ID_CANDIDATES
        if all(set(columns).issubset(table.columns) for table in sources.values())
    ]
    if len(candidates) != 1:
        detail = (
            f"ambiguous candidates {candidates}"
            if candidates else "no common identity candidate"
        )
        raise ValueError(
            f"Automatic particle identity selection failed: {detail} across "
            f"{', '.join(sources)}. Configure id_column explicitly with a stable "
            "column or composite columns for this workflow."
        )
    return candidates[0]


def identity_examples(identities: set[ParticleIdentity]) -> str:
    """Bound diagnostic examples without sorting an entire particle collection."""
    return ", ".join(repr(key[0] if len(key) == 1 else key) for key in nsmallest(5, identities))


def validate_particle_identities(
    particles: pd.DataFrame,
    columns: tuple[str, ...],
    source: str,
) -> set[ParticleIdentity]:
    """Require complete, nonempty, unique exact string keys in one source."""
    missing_columns = [column for column in columns if column not in particles.columns]
    if missing_columns:
        raise ValueError(f"{source}: missing particle identity column(s): {missing_columns}.")

    identities: set[ParticleIdentity] = set()
    duplicates: set[ParticleIdentity] = set()
    for row_number, values in enumerate(
        particles[list(columns)].itertuples(index=False, name=None), start=1
    ):
        for column, value in zip(columns, values):
            if pd.isna(value) or not isinstance(value, str):
                raise ValueError(
                    f"{source}: null or non-string particle ID in {column}, row {row_number}."
                )
            if not value.strip() or value.strip().casefold() in MISSING_ID_TOKENS:
                raise ValueError(
                    f"{source}: missing, null or empty particle ID {value!r} "
                    f"in {column}, row {row_number}."
                )
            # starfile normalizes apostrophes to double quotes before parsing.
            # Reject embedded quotes rather than certify a potentially altered ID.
            # Ordinary STAR quoting around a value has already been removed.
            if "'" in value or '"' in value:
                raise ValueError(
                    f"{source}: particle ID in {column}, row {row_number}, contains "
                    "an embedded quote; the STAR parser cannot preserve these IDs "
                    "reliably. Select a quote-free identity using id_column."
                )
        if values in identities:
            duplicates.add(values)
        identities.add(values)

    if duplicates:
        raise ValueError(
            f"{source}: duplicate particle IDs in {columns}: "
            f"{len(particles) - len(identities):,} duplicate row(s); "
            f"examples: {identity_examples(duplicates)}."
        )
    return identities


def register_particle_source(
    identities: set[ParticleIdentity],
    source: str,
    owners: dict[ParticleIdentity, str],
) -> None:
    """Require active outputs and frozen pools to be mutually disjoint."""
    overlap = identities.intersection(owners)
    if overlap:
        previous_sources = sorted({owners[identity] for identity in overlap})
        raise ValueError(
            f"Particle identity overlap: {source} shares {len(overlap):,} particle(s) "
            f"with {', '.join(previous_sources)}; examples: {identity_examples(overlap)}."
        )
    owners.update(dict.fromkeys(identities, source))


def validate_job_star(
    jcfg: JobConfig,
    pools: tuple[str, ...],
    *,
    particles: pd.DataFrame | None = None,
) -> JobStarValidation:
    """Validate job class/model/count consistency, optionally reusing a read table."""
    model_path = derive_model_star_path(jcfg)
    model_info = parse_model_star(model_path)

    if model_info.k != jcfg.k:
        raise ValueError(
            f"{jcfg.name}: configured k={jcfg.k} does not match model STAR K={model_info.k} "
            f"in {model_path}."
        )

    if particles is None:
        _, particles = read_data_star(jcfg.star)
    if "rlnClassNumber" not in particles.columns:
        raise ValueError(f"{jcfg.star}: missing required column 'rlnClassNumber'.")
    particle_count = len(particles)

    if jcfg.expected_particles is not None and particle_count != jcfg.expected_particles:
        raise ValueError(
            f"{jcfg.name}: expected {jcfg.expected_particles:,} particles, "
            f"found {particle_count:,} in {jcfg.star}."
        )

    raw_classes = particles["rlnClassNumber"]
    if raw_classes.isna().any():
        raise ValueError(f"{jcfg.name}: null/NaN values found in rlnClassNumber ({jcfg.star}).")

    try:
        numeric_classes = pd.to_numeric(raw_classes, errors="raise")
    except (ValueError, TypeError) as exc:
        raise ValueError(
            f"{jcfg.name}: non-numeric values found in rlnClassNumber ({jcfg.star})."
        ) from exc

    if not (numeric_classes == numeric_classes.astype(int)).all():
        raise ValueError(
            f"{jcfg.name}: non-integer class numbers found in rlnClassNumber ({jcfg.star})."
        )

    classes = numeric_classes.astype(int)
    valid_range = set(range(1, jcfg.k + 1))
    observed_classes = set(classes.unique())
    out_of_range = sorted(observed_classes - valid_range)
    if out_of_range:
        raise ValueError(
            f"{jcfg.name}: data STAR {jcfg.star} contains rlnClassNumber values "
            f"outside 1..{jcfg.k}: {out_of_range}."
        )

    class_counts = {cls_id: int((classes == cls_id).sum()) for cls_id in range(1, jcfg.k + 1)}
    empty_classes = tuple(sorted(cls_id for cls_id, cnt in class_counts.items() if cnt == 0))

    # Verify model vs data consistency: a class with 0.0 distribution in model.star
    # must not contain particles in data.star, and vice versa.
    inconsistent_nonempty = [
        cls_id for cls_id in model_info.empty_classes if class_counts[cls_id] > 0
    ]
    if inconsistent_nonempty:
        raise ValueError(
            f"{jcfg.name}: class(es) {inconsistent_nonempty} have 0.0 distribution in "
            f"{model_path.name} but contain particles in {jcfg.star.name}."
        )

    inconsistent_empty = [
        cls_id
        for cls_id in empty_classes
        if cls_id not in model_info.empty_classes and model_info.distributions[cls_id] > 0.0
    ]
    if inconsistent_empty:
        raise ValueError(
            f"{jcfg.name}: class(es) {inconsistent_empty} have 0 particles in "
            f"{jcfg.star.name} but non-zero distribution in {model_path.name}."
        )

    pool_counts: dict[str, int] = {}
    assigned_particle_sum = 0
    for pool_name in pools:
        assigned_cls = jcfg.classes.get(pool_name, [])
        count = sum(class_counts[c] for c in assigned_cls)
        pool_counts[pool_name] = count
        assigned_particle_sum += count

    if assigned_particle_sum != particle_count:
        raise ValueError(
            f"{jcfg.name}: assigned pool particle sum ({assigned_particle_sum:,}) "
            f"does not match job particle count ({particle_count:,})."
        )

    return JobStarValidation(
        job_name=jcfg.name,
        data_star=jcfg.star,
        model_star=model_path,
        k=jcfg.k,
        particle_count=particle_count,
        class_counts=class_counts,
        pool_counts=pool_counts,
        empty_classes=empty_classes,
        model_empty_classes=model_info.empty_classes,
    )


def metadata_value_equal(left: Any, right: Any) -> bool:
    """Compare scalar metadata, allowing only small floating serialization noise.

    The absolute tolerance covers rounding to six decimal places; the relative
    tolerance accommodates equivalent decimal representations at larger scales.
    Strings, booleans and integer/integer comparisons remain exact.
    """
    from numbers import Integral, Real

    if isinstance(left, str) or isinstance(right, str):
        return isinstance(left, str) and isinstance(right, str) and left == right
    if isinstance(left, bool) or isinstance(right, bool):
        return type(left) is type(right) and left == right
    if isinstance(left, Integral) and isinstance(right, Integral):
        return left == right
    if pd.isna(left) or pd.isna(right):
        return bool(pd.isna(left) and pd.isna(right))
    if isinstance(left, Real) and isinstance(right, Real):
        return math.isclose(float(left), float(right), rel_tol=1e-7, abs_tol=1e-6)
    return type(left) is type(right) and left == right


def assert_metadata_block_equal(expected: Any, actual: Any, context: str) -> None:
    """Require equivalent scalar/table blocks, ignoring harmless table ordering."""
    if isinstance(expected, dict) and isinstance(actual, dict):
        if set(expected) != set(actual):
            raise ValueError(f"{context}: incompatible metadata fields.")
        different = [key for key in expected if not metadata_value_equal(expected[key], actual[key])]
        if different:
            raise ValueError(f"{context}: incompatible metadata value(s): {different[:5]}.")
        return
    if not isinstance(expected, pd.DataFrame) or not isinstance(actual, pd.DataFrame):
        raise ValueError(f"{context}: incompatible or unsupported metadata block type.")
    if expected.columns.has_duplicates or actual.columns.has_duplicates:
        raise ValueError(f"{context}: duplicate metadata column names.")
    if set(expected.columns) != set(actual.columns) or len(expected) != len(actual):
        raise ValueError(f"{context}: incompatible metadata columns or row counts.")
    columns = list(expected.columns)
    left_rows = list(expected[columns].itertuples(index=False, name=None))
    right_rows = list(actual[columns].itertuples(index=False, name=None))
    # Matching rather than sorting handles close numeric values in rows whose
    # other fields differ. Metadata tables are small; particle tables never use it.
    candidates = [
        [j for j, right in enumerate(right_rows)
         if all(metadata_value_equal(a, b) for a, b in zip(left, right))]
        for left in left_rows
    ]
    matched: dict[int, int] = {}

    def match_row(index: int, visited: set[int]) -> bool:
        for candidate in candidates[index]:
            if candidate in visited:
                continue
            visited.add(candidate)
            if candidate not in matched or match_row(matched[candidate], visited):
                matched[candidate] = index
                return True
        return False

    if any(not match_row(index, set()) for index in range(len(left_rows))):
        raise ValueError(f"{context}: incompatible metadata table values.")


def assert_metadata_compatible(
    expected_blocks: dict[str, Any], actual_blocks: dict[str, Any], context: str,
) -> None:
    """Require all non-particle blocks to survive a STAR round trip unchanged."""
    expected = {key: value for key, value in expected_blocks.items() if key != "particles"}
    actual = {key: value for key, value in actual_blocks.items() if key != "particles"}
    if set(expected) != set(actual):
        raise ValueError(
            f"{context}: incompatible non-particle STAR blocks: "
            f"expected {sorted(expected)}, found {sorted(actual)}."
        )
    for name, value in expected.items():
        assert_metadata_block_equal(value, actual[name], f"{context}, data_{name}")


def optics_group_ids(values: pd.Series, context: str) -> list[int]:
    """Validate optics group identifiers without truncating fractional references."""
    groups: list[int] = []
    for value in values:
        try:
            if pd.api.types.is_bool(value) or pd.isna(value):
                raise ValueError
            numeric = pd.to_numeric(value, errors="raise")
            group = int(numeric)
            if not math.isfinite(float(numeric)) or numeric != group or group < 1:
                raise ValueError
        except (ValueError, TypeError, OverflowError) as exc:
            raise ValueError(f"{context}: invalid rlnOpticsGroup {value!r}; expected a positive integer.") from exc
        groups.append(group)
    return groups


def validate_metadata_sources(
    sources: dict[str, dict[str, Any]],
) -> tuple[dict[str, Any], dict[str, tuple[int, ...]], bool]:
    """Validate and combine compatible optics and other non-particle metadata.

    Shared optics IDs must have matching definitions. Disjoint optics definitions
    are retained without renumbering. Files without optics are supported only when
    every source omits optics and particle optics references. Previous inputs use
    the same checks as active and frozen sources.
    """
    if not sources:
        raise ValueError("No STAR sources available for metadata validation.")
    presence = {"optics" in blocks for blocks in sources.values()}
    if len(presence) != 1:
        raise ValueError("Incompatible metadata: mixed STAR inputs with and without data_optics.")
    has_optics = presence.pop()
    canonical: dict[str, Any] = {}
    referenced_groups: dict[str, tuple[int, ...]] = {}
    optics_columns: list[str] | None = None
    optics_rows: dict[int, tuple[Any, ...]] = {}
    optics_owners: dict[int, str] = {}
    first_source: str | None = None

    for source, blocks in sources.items():
        particles = blocks.get("particles")
        if not isinstance(particles, pd.DataFrame):
            raise ValueError(f"{source}: missing or invalid particles table for metadata validation.")
        if particles.columns.has_duplicates:
            raise ValueError(f"{source}: duplicate particle column names.")
        other = {name: block for name, block in blocks.items() if name not in ("particles", "optics")}
        if first_source is None:
            first_source = source
            for name, block in other.items():
                if not isinstance(block, (dict, pd.DataFrame)):
                    raise ValueError(f"{source}: unsupported metadata block data_{name}.")
                assert_metadata_block_equal(block, block, f"{source}, data_{name}")
                canonical[name] = block.copy()
        else:
            baseline = {name: block for name, block in canonical.items() if name != "optics"}
            assert_metadata_compatible(baseline, other, f"{source} versus {first_source}")

        if not has_optics:
            if "rlnOpticsGroup" in particles.columns:
                raise ValueError(f"{source}: rlnOpticsGroup references require a data_optics block.")
            referenced_groups[source] = ()
            continue

        optics = blocks["optics"]
        if not isinstance(optics, pd.DataFrame) or optics.empty:
            raise ValueError(f"{source}: data_optics must be a nonempty table.")
        if optics.columns.has_duplicates:
            raise ValueError(f"{source}: duplicate optics column names.")
        if "rlnOpticsGroup" not in optics.columns:
            raise ValueError(f"{source}: data_optics is missing rlnOpticsGroup.")
        if "rlnOpticsGroup" not in particles.columns:
            raise ValueError(f"{source}: particles are missing rlnOpticsGroup for data_optics.")
        groups = optics_group_ids(optics["rlnOpticsGroup"], f"{source}, data_optics")
        if len(groups) != len(set(groups)):
            raise ValueError(f"{source}: duplicate rlnOpticsGroup definitions in data_optics.")
        references = set(optics_group_ids(particles["rlnOpticsGroup"], f"{source}, data_particles"))
        undefined = sorted(references - set(groups))
        if undefined:
            raise ValueError(f"{source}: undefined rlnOpticsGroup reference(s): {undefined}.")
        referenced_groups[source] = tuple(sorted(references))
        if optics_columns is None:
            optics_columns = list(optics.columns)
        elif set(optics_columns) != set(optics.columns):
            raise ValueError(f"{source}: incompatible data_optics columns.")
        for group, row in zip(groups, optics[optics_columns].itertuples(index=False, name=None)):
            for column, value in zip(optics_columns, row):
                if pd.isna(value) or (isinstance(value, str) and (not value.strip() or value.strip().casefold() in MISSING_ID_TOKENS)):
                    raise ValueError(f"{source}: null/empty optics value in {column}, group {group}.")
                if isinstance(value, (int, float)) and not math.isfinite(value):
                    raise ValueError(f"{source}: non-finite optics value in {column}, group {group}.")
            if group in optics_rows:
                differing = [
                    column for column, old, new in zip(optics_columns, optics_rows[group], row)
                    if not metadata_value_equal(old, new)
                ]
                if differing:
                    raise ValueError(
                        f"{source}: conflicting optics group {group} versus {optics_owners[group]}; "
                        f"different field(s): {differing}."
                    )
            else:
                optics_rows[group] = row
                optics_owners[group] = source

    if has_optics:
        canonical["optics"] = pd.DataFrame(list(optics_rows.values()), columns=optics_columns)
    # Preserve the first input's block order, appending any union-only metadata.
    first_blocks = next(iter(sources.values()))
    canonical = {name: canonical[name] for name in first_blocks if name in canonical}
    return canonical, referenced_groups, has_optics


def validate_star_inputs(cfg: MergeConfig) -> StarValidationReport:
    """Validate counts, identities, previous inputs, and disjoint frozen sources."""
    job_reports: dict[str, JobStarValidation] = {}
    frozen_reports: dict[str, FrozenStarValidation] = {}
    pool_totals: dict[str, int] = {pool: 0 for pool in cfg.pools}
    # Use one identity schema across all outputs, frozen pools and previous inputs.
    # Keep the parsed tables so class checks and identity checks see the same rows.
    sources: dict[str, pd.DataFrame] = {}
    job_sources: dict[str, str] = {}
    input_sources: dict[str, str] = {}
    frozen_sources: dict[str, str] = {}
    metadata_sources: dict[str, dict[str, Any]] = {}
    source_blocks: dict[Path, dict[str, Any]] = {}
    input_hashes: dict[Path, str] = {}
    explicit_columns = (
        () if cfg.id_column == "auto"
        else (cfg.id_column,) if isinstance(cfg.id_column, str)
        else cfg.id_column
    )
    active_particles = 0

    for job_name, jcfg in cfg.jobs.items():
        source = f"jobs.{job_name} output ({jcfg.star})"
        input_hashes[jcfg.star] = sha256_file(jcfg.star)
        model_path = derive_model_star_path(jcfg)
        input_hashes[model_path] = sha256_file(model_path)
        blocks, particles = read_data_star(jcfg.star, id_columns=explicit_columns)
        source_blocks[jcfg.star] = blocks
        metadata_sources[source] = blocks
        sources[source] = particles
        job_sources[job_name] = source
        jval = validate_job_star(jcfg, cfg.pools, particles=particles)
        job_reports[job_name] = jval
        active_particles += jval.particle_count
        for pool_name, count in jval.pool_counts.items():
            pool_totals[pool_name] += count

        if jcfg.input_star is not None:
            input_source = f"jobs.{job_name} input ({jcfg.input_star})"
            input_hashes[jcfg.input_star] = sha256_file(jcfg.input_star)
            input_blocks, input_particles = read_data_star(
                jcfg.input_star, require_class_numbers=False, id_columns=explicit_columns, allow_empty=True,
            )
            source_blocks[jcfg.input_star] = input_blocks
            metadata_sources[input_source] = input_blocks
            sources[input_source] = input_particles
            input_sources[job_name] = input_source

    frozen_particles = 0
    frozen_expected = sum(f.expected_particles or 0 for f in cfg.frozen.values())
    for pool_name, fcfg in cfg.frozen.items():
        source = f"frozen.{pool_name} ({fcfg.star})"
        input_hashes[fcfg.star] = sha256_file(fcfg.star)
        blocks, particles = read_data_star(
            fcfg.star, require_class_numbers=False, id_columns=explicit_columns, allow_empty=True,
        )
        source_blocks[fcfg.star] = blocks
        metadata_sources[source] = blocks
        particle_count = len(particles)
        if fcfg.expected_particles is not None and particle_count != fcfg.expected_particles:
            raise ValueError(
                f"frozen.{pool_name}: expected {fcfg.expected_particles:,} particles, "
                f"found {particle_count:,} in {fcfg.star}."
            )
        sources[source] = particles
        frozen_sources[pool_name] = source
        frozen_reports[pool_name] = FrozenStarValidation(
            pool_name=pool_name, star=fcfg.star, mode=fcfg.mode, particle_count=particle_count,
        )
        frozen_particles += particle_count
        pool_totals[pool_name] += particle_count

    id_columns = select_identity_columns(cfg.id_column, sources)
    identities = {
        source: validate_particle_identities(particles, id_columns, source)
        for source, particles in sources.items()
    }
    owners: dict[ParticleIdentity, str] = {}
    for job_name, source in job_sources.items():
        output_ids = identities[source]
        register_particle_source(output_ids, source, owners)
        if job_name in input_sources:
            input_source = input_sources[job_name]
            input_ids = identities[input_source]
            input_count = len(sources[input_source])
            output_count = job_reports[job_name].particle_count
            missing = input_ids - output_ids
            unexpected = output_ids - input_ids
            if missing or unexpected or input_count != output_count:
                raise ValueError(
                    f"jobs.{job_name}: previous input/output particle identity mismatch "
                    f"between {input_source} and {source}; "
                    f"input count={input_count:,}, output count={output_count:,}; "
                    f"missing from output: {len(missing):,} "
                    f"(examples: {identity_examples(missing) or 'none'}); "
                    f"unexpected in output: {len(unexpected):,} "
                    f"(examples: {identity_examples(unexpected) or 'none'})."
                )
            job_reports[job_name] = replace(
                job_reports[job_name], input_star_verified=True,
                input_particle_count=input_count,
            )

    for source in frozen_sources.values():
        register_particle_source(identities[source], source, owners)

    metadata_blocks, optics_by_source, has_optics = validate_metadata_sources(metadata_sources)
    for job_name, source in job_sources.items():
        job_reports[job_name] = replace(job_reports[job_name], optics_groups=optics_by_source[source])
    for pool_name, source in frozen_sources.items():
        frozen_reports[pool_name] = replace(frozen_reports[pool_name], optics_groups=optics_by_source[source])

    total_particles = active_particles + frozen_particles
    if cfg.expected_total is not None and total_particles != cfg.expected_total:
        raise ValueError(
            f"Total validated particles ({total_particles:,}) does not match "
            f"configured expected_total ({cfg.expected_total:,})."
        )

    report = StarValidationReport(
        jobs=job_reports,
        active_particles=active_particles,
        frozen_expected_particles=frozen_expected,
        total_particles=total_particles,
        pool_totals=pool_totals,
        frozen=frozen_reports,
        frozen_particles=frozen_particles,
        id_columns=id_columns,
        unique_particle_ids=len(owners),
        all_previous_inputs_verified=(
            True if all(j.input_star_verified is True for j in job_reports.values()) else None
        ),
        optics_groups=tuple(sorted({group for groups in optics_by_source.values() for group in groups})),
        has_optics_block=has_optics,
        metadata_verified=True,
        source_blocks=source_blocks,
        metadata_blocks=metadata_blocks,
        input_hashes=input_hashes,
    )
    if cfg.previous_provenance is not None:
        input_hashes[cfg.previous_provenance] = sha256_file(cfg.previous_provenance)
        report = replace(
            report, previous_records=load_previous_provenance(cfg, report),
            previous_provenance_verified=True,
        )
    verify_input_hashes(input_hashes)
    # Dry-runs check output schemas and conservation too, without creating files.
    build_output_pools(cfg, report)
    return report


def sha256_file(path: Path) -> str:
    """Fingerprint a local input or staged output without loading it into memory."""
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def verify_input_hashes(hashes: dict[Path, str]) -> None:
    for path, expected in hashes.items():
        if sha256_file(path) != expected:
            raise ValueError(f"Input changed after validation: {path}. Validate again before writing.")


def particle_keys(particles: pd.DataFrame, columns: tuple[str, ...]) -> list[ParticleIdentity]:
    """Return already validated keys in source row order."""
    return list(particles[list(columns)].itertuples(index=False, name=None))


def source_pool_expectations(cfg: MergeConfig, report: StarValidationReport) -> dict[ParticleIdentity, str | None]:
    expected = {}
    for job in cfg.jobs.values():
        expected.update(dict.fromkeys(particle_keys(report.source_blocks[job.star]["particles"], report.id_columns), job.input_pool))
    for pool, frozen in cfg.frozen.items():
        expected.update(dict.fromkeys(particle_keys(report.source_blocks[frozen.star]["particles"], report.id_columns), pool))
    return expected


def load_previous_provenance(cfg: MergeConfig, report: StarValidationReport) -> dict[ParticleIdentity, dict[str, Any]]:
    """Import native JSON or historical CSV without discarding prior fields."""
    path = cfg.previous_provenance
    columns = report.id_columns
    records: dict[ParticleIdentity, dict[str, Any]] = {}
    if path.suffix.lower() == ".json":
        def reject_constant(value):
            raise ValueError(f"{path}: invalid JSON provenance constant {value}.")

        data = json.loads(path.read_text(encoding="utf-8"), parse_constant=reject_constant)
        if not isinstance(data, dict) or data.get("schema_version") != 1 or data.get("id_columns") != list(columns):
            raise ValueError(f"{path}: unsupported previous provenance JSON schema or identity columns.")
        if not isinstance(data.get("round"), str) or not data["round"].strip():
            raise ValueError(f"{path}: previous provenance round must be a nonempty string.")
        if cfg.previous_round is not None and data.get("round") != cfg.previous_round:
            raise ValueError(f"{path}: previous provenance round does not match {cfg.previous_round}.")
        rows = data.get("particles")
        if not isinstance(rows, list):
            raise ValueError(f"{path}: previous provenance requires a particles list.")
        for row in rows:
            if (not isinstance(row, dict) or not isinstance(row.get("identity"), list)
                    or len(row["identity"]) != len(columns) or not isinstance(row.get("pool"), str)
                    or not isinstance(row.get("history"), list)
                    or not all(isinstance(event, dict) for event in row["history"])):
                raise ValueError(f"{path}: malformed previous provenance particle record.")
            if not all(isinstance(value, str) for value in row["identity"]):
                raise ValueError(f"{path}: provenance identities must be strings.")
            if not row["pool"].strip():
                raise ValueError(f"{path}: previous provenance pool must be nonempty.")
            legacy = row.get("legacy_fields", {})
            if not isinstance(legacy, dict) or not all(isinstance(key, str) and isinstance(value, str) for key, value in legacy.items()):
                raise ValueError(f"{path}: provenance legacy_fields must map strings to strings.")
            key = tuple(row["identity"])
            if key in records:
                raise ValueError(f"{path}: duplicate provenance identity {key!r}.")
            records[key] = row
    elif path.suffix.lower() == ".csv":
        if cfg.previous_round is None:
            raise ValueError(f"{path}: previous_round is required to interpret historical CSV provenance.")
        pool_column = f"{cfg.previous_round.lower()}_pool"
        with path.open(encoding="utf-8", newline="") as stream:
            reader = csv.DictReader(stream)
            headers = reader.fieldnames or []
            if len(set(headers)) != len(headers) or not set((*columns, pool_column)).issubset(headers):
                raise ValueError(f"{path}: unsupported historical provenance CSV; requires unique identity columns and {pool_column}.")
            for row in reader:
                if None in row or any(value is None for value in row.values()):
                    raise ValueError(f"{path}: malformed historical provenance CSV row.")
                key = tuple(row[column] for column in columns)
                if key in records:
                    raise ValueError(f"{path}: duplicate provenance identity {key!r}.")
                records[key] = {"identity": list(key), "pool": row[pool_column], "history": [], "legacy_fields": row}
    else:
        raise ValueError(f"{path}: unsupported previous provenance format; use native JSON v1 or historical CSV.")

    validate_particle_identities(pd.DataFrame(list(records), columns=columns), columns, str(path))
    expected = source_pool_expectations(cfg, report)
    missing, extra = set(expected) - records.keys(), records.keys() - set(expected)
    if missing or extra:
        raise ValueError(
            f"{path}: provenance identity coverage mismatch; missing {len(missing):,} "
            f"({identity_examples(missing)}), unexpected {len(extra):,} ({identity_examples(extra)})."
        )
    for key, pool in expected.items():
        if pool is not None and records[key]["pool"] != pool:
            raise ValueError(f"{path}: previous provenance pool mismatch for {key!r}: expected {pool!r}, found {records[key]['pool']!r}.")
    return records


def build_output_pools(cfg: MergeConfig, report: StarValidationReport) -> dict[str, dict[str, Any]]:
    """Route source rows deterministically and prove complete identity conservation."""
    if report.id_columns is None or not report.metadata_verified:
        raise ValueError("Complete identity and metadata validation is required before merging.")
    outputs = {}
    owners: dict[ParticleIdentity, str] = {}
    default_table = report.source_blocks[next(iter(cfg.jobs.values())).star]["particles"]
    for pool in cfg.pools:
        parts = []
        frozen = cfg.frozen.get(pool)
        if frozen is not None:
            parts.append(report.source_blocks[frozen.star]["particles"])
        for job in cfg.jobs.values():
            assigned = job.classes.get(pool, [])
            if assigned:
                if frozen is not None and frozen.mode == "copy_only":
                    raise ValueError(f"Pool {pool}: copy_only forbids active class assignments.")
                table = report.source_blocks[job.star]["particles"]
                selected = table.loc[pd.to_numeric(table["rlnClassNumber"]).isin(assigned)]
                if len(selected):
                    parts.append(selected)
        columns = list(parts[0].columns if parts else default_table.columns)
        for part in parts:
            if set(part.columns) != set(columns):
                raise ValueError(f"Pool {pool}: incompatible particle columns; missing {sorted(set(columns)-set(part.columns))}, extra {sorted(set(part.columns)-set(columns))}.")
        particles = (
            pd.concat([part.loc[:, columns] for part in parts], ignore_index=True)
            if parts else default_table.iloc[:0].copy()
        )
        offset = 0
        for part in parts:
            assert_particle_values_equal(
                part.loc[:, columns], particles.iloc[offset:offset + len(part)],
                f"Pool {pool}: concatenation", serialized=False,
            )
            offset += len(part)
        ids = validate_particle_identities(particles, report.id_columns, f"output pool {pool}")
        register_particle_source(ids, f"output pool {pool}", owners)
        if len(particles) != report.pool_totals[pool]:
            raise ValueError(f"Pool {pool}: output particle count differs from validated routing count.")
        metadata = (
            {key: value for key, value in report.source_blocks[frozen.star].items() if key != "particles"}
            if frozen is not None and frozen.mode == "copy_only" else report.metadata_blocks
        )
        outputs[pool] = {**metadata, "particles": particles}
    expected = source_pool_expectations(cfg, report)
    if set(owners) != set(expected) or len(owners) != report.total_particles:
        raise ValueError("Output particle conservation failed: input/output identity unions or counts differ.")
    return outputs


def build_provenance(cfg: MergeConfig, report: StarValidationReport, outputs: dict[str, dict[str, Any]]) -> dict[str, Any]:
    """Append current origins to prior lineage, retaining unknown historical fields."""
    origins = {}
    for job in cfg.jobs.values():
        table = report.source_blocks[job.star]["particles"]
        class_to_pool = {number: pool for pool, numbers in job.classes.items() for number in numbers}
        iteration = re.search(r"_it(\d+)_", job.star.name)
        for key, number in zip(particle_keys(table, report.id_columns), table["rlnClassNumber"]):
            origins[key] = {
                "round": cfg.round_label, "pool": class_to_pool[int(number)],
                "source_type": "job", "source": job.name, "source_star": str(job.star),
                "input_pool": job.input_pool or report.previous_records.get(key, {}).get("pool"),
                "class_number": int(number),
                "iteration": int(iteration.group(1)) if iteration else None,
            }
    for pool, frozen in cfg.frozen.items():
        for key in particle_keys(report.source_blocks[frozen.star]["particles"], report.id_columns):
            origins[key] = {
                "round": cfg.round_label, "pool": pool, "source_type": "frozen",
                "source": frozen.source_label or f"FROZEN_{cfg.previous_round.upper() if cfg.previous_round else pool.upper()}",
                "source_star": str(frozen.star), "input_pool": pool, "class_number": None,
                "iteration": None, "mode": frozen.mode,
            }
    records = []
    for pool, blocks in outputs.items():
        for key in particle_keys(blocks["particles"], report.id_columns):
            previous = report.previous_records.get(key, {})
            record = dict(previous)
            record.update(identity=list(key), pool=pool, history=[*previous.get("history", []), origins[key]])
            records.append(record)
    return {"schema_version": 1, "round": cfg.round_label, "id_columns": list(report.id_columns), "particles": records}


def effective_config_toml(cfg: MergeConfig) -> str:
    """Serialize the supported schema without a TOML-writing dependency."""
    def assignment(key, value):
        if isinstance(value, Path):
            value = str(value)
        if isinstance(value, tuple):
            value = list(value)
        return f"{key} = {json.dumps(value, ensure_ascii=False)}"

    lines = []
    for key in ("round", "previous_round", "project_dir", "output_dir", "pools", "id_column", "expected_total", "previous_provenance"):
        value = cfg.round_label if key == "round" else getattr(cfg, key)
        if value is not None:
            lines.append(assignment(key, value))
    for pool, frozen in cfg.frozen.items():
        lines.extend(["", f"[frozen.{json.dumps(pool)}]"])
        for key in ("star", "mode", "expected_particles", "source_label"):
            if getattr(frozen, key) is not None:
                lines.append(assignment(key, getattr(frozen, key)))
    for name, job in cfg.jobs.items():
        lines.extend(["", f"[jobs.{json.dumps(name)}]"])
        for key in ("star", "k", "input_pool", "input_star", "model_star", "expected_particles", "note"):
            if getattr(job, key) is not None:
                lines.append(assignment(key, getattr(job, key)))
        lines.append(f"[jobs.{json.dumps(name)}.classes]")
        for pool, numbers in job.classes.items():
            lines.append(assignment(json.dumps(pool), numbers))
    return "\n".join(lines) + "\n"


def write_provenance_csv(path: Path, provenance: dict[str, Any]) -> None:
    """Provide a cumulative flat view while JSON retains full structured lineage."""
    rows = []
    headers = list(provenance["id_columns"])
    seen = set(headers)
    for record in provenance["particles"]:
        row = dict(record.get("legacy_fields", {}))
        row.update(zip(provenance["id_columns"], record["identity"]))
        for event in record["history"]:
            if not isinstance(event.get("round"), str) or "source_type" not in event:
                continue
            prefix = event["round"].lower()
            row.update({
                f"{prefix}_source_job": event.get("source", ""),
                f"{prefix}_source_class": "" if event.get("class_number") is None else str(event["class_number"]),
                f"{prefix}_pool": event.get("pool", ""),
                f"{prefix}_frozen": str(event["source_type"] == "frozen").lower(),
            })
        for key in row:
            if key not in seen:
                headers.append(key)
                seen.add(key)
        rows.append(row)
    with path.open("w", encoding="utf-8", newline="") as stream:
        writer = csv.DictWriter(stream, fieldnames=headers)
        writer.writeheader()
        writer.writerows(rows)


def assert_particle_values_equal(expected: pd.DataFrame, actual: pd.DataFrame, context: str, *, serialized: bool) -> None:
    """Catch integer precision loss as well as other metadata changes.

    Pandas' numeric tolerance can hide int-to-float rounding of large integers;
    use Python scalar equality for integers even when dtypes differ.
    """
    if list(expected.columns) != list(actual.columns) or len(expected) != len(actual):
        raise ValueError(f"{context}: particle schema/count mismatch.")
    for row_number, (left, right) in enumerate(zip(
        expected.itertuples(index=False, name=None), actual.itertuples(index=False, name=None),
    ), start=1):
        for column, old, new in zip(expected.columns, left, right):
            if pd.isna(old) or pd.isna(new):
                equal = bool(pd.isna(old) and pd.isna(new))
            elif isinstance(old, Integral) or isinstance(new, Integral):
                old = old.item() if hasattr(old, "item") else old
                new = new.item() if hasattr(new, "item") else new
                equal = old == new
            elif serialized and isinstance(old, float) and isinstance(new, float):
                equal = math.isclose(old, new, rel_tol=1e-12, abs_tol=1e-12)
            else:
                equal = old == new
            if not equal:
                raise ValueError(f"{context}: particle metadata changed in {column}, row {row_number}: {old!r} -> {new!r}.")


def verify_written_star(path: Path, expected_blocks: dict[str, Any], id_columns: tuple[str, ...]) -> set[ParticleIdentity]:
    """Read back a staged STAR and check identities, every particle value and metadata."""
    actual_blocks, actual = read_data_star(path, require_class_numbers=False, id_columns=id_columns, allow_empty=True)
    expected = expected_blocks["particles"]
    ids = validate_particle_identities(actual, id_columns, str(path))
    if particle_keys(actual, id_columns) != particle_keys(expected, id_columns):
        raise ValueError(f"{path}: STAR round-trip identity or row-order mismatch.")
    if list(actual.columns) != list(expected.columns) or len(actual) != len(expected):
        raise ValueError(f"{path}: STAR round-trip particle schema/count mismatch.")
    assert_particle_values_equal(expected, actual, f"{path}: STAR round-trip", serialized=True)
    validate_metadata_sources({str(path): actual_blocks})
    assert_metadata_compatible(expected_blocks, actual_blocks, str(path))
    return ids


def publish_directory(staging: Path, output: Path) -> None:
    """Publish complete sibling storage atomically, without replacing any target.

    GPFS may not implement RENAME_NOREPLACE. An atomic directory symlink is the
    fallback: its private sibling storage must then remain beside the final link.
    Neither path uses an unsafe exists-check followed by an overwriting rename.
    """
    if staging.parent.resolve() != output.parent.resolve():
        raise ValueError("Atomic publication requires sibling staging and output directories.")
    libc = ctypes.CDLL(None, use_errno=True)
    rename = getattr(libc, "renameat2", None)
    if rename is not None:
        rename.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
        rename.restype = ctypes.c_int
        if rename(-100, os.fsencode(staging), -100, os.fsencode(output), 1) == 0:
            return
        error = ctypes.get_errno()
        if error not in (errno.EINVAL, errno.ENOSYS, errno.ENOTSUP):
            raise OSError(error, os.strerror(error), str(output))
    os.symlink(staging.name, output, target_is_directory=True)


def execute_merge(
    cfg: MergeConfig,
    report: StarValidationReport,
    *,
    allow_unverified_inputs: bool = False,
    config_path: Path | None = None,
    argv: list[str] | None = None,
) -> Path:
    """Stage, verify, and atomically publish one complete, non-overwriting result."""
    output = cfg.output_dir.absolute()
    if os.path.lexists(output):
        raise FileExistsError(f"Output already exists; refusing to overwrite: {output}")
    missing = [name for name, job in report.jobs.items() if job.input_star_verified is not True]
    if missing and not allow_unverified_inputs:
        raise ValueError(
            f"Previous input verification is missing for {missing}. Configure input_star "
            "or explicitly use --allow-unverified-inputs to record incomplete lineage."
        )
    if config_path is not None and cfg.config_sha256 is not None:
        if sha256_file(config_path) != cfg.config_sha256:
            raise ValueError(f"Configuration changed after loading: {config_path}.")
        report.input_hashes[config_path] = cfg.config_sha256
    verify_input_hashes(report.input_hashes)
    pools = build_output_pools(cfg, report)
    provenance = build_provenance(cfg, report, pools)
    output.parent.mkdir(parents=True, exist_ok=True)
    staging = Path(tempfile.mkdtemp(prefix=f".{output.name}.data-", dir=output.parent))
    try:
        published_ids: dict[ParticleIdentity, str] = {}
        output_manifest = {}
        for pool, blocks in pools.items():
            count = len(blocks["particles"])
            filename = f"particles_{cfg.round_label}_{pool}_{count}.star"
            path = staging / filename
            frozen = cfg.frozen.get(pool)
            copy_only = frozen is not None and frozen.mode == "copy_only"
            if copy_only:
                shutil.copyfile(frozen.star, path)
                if sha256_file(path) != report.input_hashes[frozen.star]:
                    raise ValueError(f"Pool {pool}: frozen copy differs from the validated input bytes.")
            else:
                starfile.write(blocks, path, float_format="%.17g", quote_all_strings=True)
            ids = verify_written_star(path, blocks, report.id_columns)
            register_particle_source(ids, f"written pool {pool}", published_ids)
            output_manifest[pool] = {
                "file": filename, "count": count, "sha256": sha256_file(path),
                "mode": frozen.mode if frozen is not None else "active",
            }
        expected = source_pool_expectations(cfg, report)
        if set(published_ids) != set(expected) or len(published_ids) != report.total_particles:
            raise ValueError("Written STAR outputs failed complete particle identity conservation.")
        if {tuple(record["identity"]) for record in provenance["particles"]} != set(published_ids):
            raise ValueError("Provenance identities differ from written output identities.")

        (staging / "config.toml").write_text(effective_config_toml(cfg), encoding="utf-8")
        if config_path is not None:
            shutil.copyfile(config_path, staging / "source_config.toml")
        if cfg.previous_provenance is not None:
            shutil.copyfile(cfg.previous_provenance, staging / f"previous_provenance{cfg.previous_provenance.suffix.lower()}")
        with (staging / "provenance.json").open("w", encoding="utf-8") as stream:
            json.dump(provenance, stream, ensure_ascii=False, separators=(",", ":"), allow_nan=False)
            stream.write("\n")
        write_provenance_csv(staging / "provenance.csv", provenance)
        summary = format_validation_summary(cfg, report)
        summary += f"\nOutput identity conservation: confirmed ({report.total_particles:,} particles).\n"
        if missing:
            summary += f"Incomplete previous-input verification explicitly allowed for: {', '.join(missing)}.\n"
        (staging / "summary.txt").write_text(summary, encoding="utf-8")
        software = {"class_pool_merge": VERSION, "python": sys.version.split()[0]}
        software["implementation_sha256"] = sha256_file(Path(__file__))
        for package in ("pandas", "starfile"):
            software[package] = importlib.metadata.version(package)
        manifest = {
            "schema_version": 1, "round": cfg.round_label,
            "created_utc": datetime.now(timezone.utc).isoformat(), "software": software,
            "config": tomllib.loads(effective_config_toml(cfg)),
            "execution": {"argv": argv or [], "config_path": str(config_path) if config_path else None,
                          "allow_unverified_inputs": allow_unverified_inputs},
            "validation": {"input_output_conserved": True, "metadata_verified": report.metadata_verified,
                           "previous_inputs_verified": [name for name in cfg.jobs if name not in missing],
                           "all_previous_inputs_verified": report.all_previous_inputs_verified,
                           "previous_provenance_verified": report.previous_provenance_verified},
            "counts": {"active": report.active_particles, "frozen": report.frozen_particles,
                       "total": report.total_particles, "unique": report.unique_particle_ids, "pools": report.pool_totals},
            "jobs": {name: {"star": str(job.data_star), "model_star": str(job.model_star),
                             "k": job.k, "particle_count": job.particle_count,
                             "class_counts": job.class_counts, "pool_counts": job.pool_counts,
                             "empty_classes": job.empty_classes, "input_star_verified": job.input_star_verified}
                     for name, job in report.jobs.items()},
            "inputs": [{"path": str(path), "sha256": digest} for path, digest in report.input_hashes.items()],
            "outputs": output_manifest,
            "files": {path.name: sha256_file(path) for path in sorted(staging.iterdir())},
        }
        (staging / "manifest.json").write_text(json.dumps(manifest, indent=2, allow_nan=False) + "\n", encoding="utf-8")
        verify_input_hashes(report.input_hashes)
        for path in staging.iterdir():
            with path.open("rb") as stream:
                os.fsync(stream.fileno())
        publish_directory(staging, output)
    except BaseException:
        # A signal may arrive just after symlink publication. Never remove storage
        # already reachable through the final link, even if the syscall's caller
        # did not get to observe its successful return.
        try:
            published_backing = output.is_symlink() and os.readlink(output) == staging.name
        except OSError:
            published_backing = True  # Retain storage if publication cannot be inspected.
        if not published_backing:
            shutil.rmtree(staging, ignore_errors=True)
        raise
    return output


def format_validation_summary(
    cfg: MergeConfig,
    star_report: StarValidationReport | None = None,
) -> str:
    """Format a human-readable summary of the validated configuration and STAR inputs."""
    lines = [
        "=" * 72,
        f"RELION Class3D Pool Merge Validation — {cfg.round_label}",
        "=" * 72,
        f"Project directory : {cfg.project_dir}",
        f"Output directory  : {cfg.output_dir}",
        f"Output pools ({len(cfg.pools)}) : {', '.join(cfg.pools)}",
        f"Identity column   : {cfg.id_column if isinstance(cfg.id_column, str) else ', '.join(cfg.id_column)}",
    ]
    if cfg.expected_total is not None:
        lines.append(f"Expected total    : {cfg.expected_total:,} particles")

    if cfg.frozen:
        lines.append("")
        lines.append(f"Frozen pools ({len(cfg.frozen)}):")
        for pool_name, fcfg in cfg.frozen.items():
            exp = f", expected={fcfg.expected_particles:,}" if fcfg.expected_particles is not None else ""
            measured = ""
            if star_report is not None and star_report.frozen is not None:
                fval = star_report.frozen.get(pool_name)
                if fval is not None:
                    measured = f", particles={fval.particle_count:,} (count verified)"
            lines.append(f"  - {pool_name}: mode={fcfg.mode}{measured}{exp} ({fcfg.star})")

    lines.append("")
    lines.append(f"Active Class3D jobs ({len(cfg.jobs)}):")
    for job_name, jcfg in cfg.jobs.items():
        in_pool = f", input_pool={jcfg.input_pool}" if jcfg.input_pool else ""
        if star_report is not None and job_name in star_report.jobs:
            jval = star_report.jobs[job_name]
            lines.append(
                f"  - {job_name}: K={jval.k} (model verified){in_pool}, "
                f"particles={jval.particle_count:,} ({jcfg.star.name})"
            )
            empty_str = (
                ", ".join(map(str, jval.empty_classes)) if jval.empty_classes else "none"
            )
            lines.append(f"      Zero-particle classes : {empty_str}")
            if jval.input_star_verified is True:
                lines.append(
                    f"      Previous input: identity match confirmed "
                    f"({jval.input_particle_count:,} particles; {jcfg.input_star})"
                )
            elif jcfg.input_star is None:
                lines.append("      Previous input: not performed (input_star not configured)")
            else:
                lines.append("      Previous input: not verified")
            for pool_name in cfg.pools:
                assigned = jcfg.classes.get(pool_name, [])
                if assigned or jval.pool_counts.get(pool_name, 0) > 0:
                    pcount = jval.pool_counts[pool_name]
                    lines.append(
                        f"      -> {pool_name:12s}: {pcount:>8,d} particles "
                        f"({len(assigned):2d} classes: {assigned})"
                    )
        else:
            exp = f", expected={jcfg.expected_particles:,}" if jcfg.expected_particles is not None else ""
            lines.append(f"  - {job_name}: K={jcfg.k}{in_pool}{exp} ({jcfg.star})")
            for pool_name in cfg.pools:
                assigned = jcfg.classes.get(pool_name, [])
                if assigned:
                    lines.append(f"      -> {pool_name:12s}: {len(assigned):2d} classes {assigned}")

    if star_report is not None:
        lines.append("")
        if cfg.frozen and star_report.frozen_particles is None:
            lines.append("Pool totals (active counts + configured frozen expectations):")
            lines.append("  Frozen STAR files have not been validated.")
            if any(f.expected_particles is None for f in cfg.frozen.values()):
                lines.append("  Frozen pools without expected_particles are excluded from totals.")
        else:
            lines.append("Validated pool totals:")
        for pool_name in cfg.pools:
            count = star_report.pool_totals[pool_name]
            pct = (100.0 * count / star_report.total_particles) if star_report.total_particles else 0.0
            lines.append(f"  {pool_name:14s}: {count:>8,d} ({pct:6.2f}%)")
        lines.append(f"  {'TOTAL':14s}: {star_report.total_particles:>8,d}")

        lines.append("")
        if star_report.id_columns is not None and star_report.unique_particle_ids is not None:
            lines.append(
                f"Identity checks confirmed: {', '.join(star_report.id_columns)}; "
                f"{star_report.unique_particle_ids:,} unique particles; sources disjoint."
            )
            if cfg.id_column == "auto":
                lines.append(
                    "  Auto selected the sole common candidate; identity stability "
                    "outside these files is not established."
                )
        if cfg.frozen and star_report.frozen is not None:
            lines.append(
                f"Frozen checks confirmed: {len(star_report.frozen)} pool(s), "
                f"{star_report.frozen_particles:,} particles; counts, uniqueness and disjointness."
            )
        elif not cfg.frozen:
            lines.append("Frozen checks: not applicable (no frozen pools configured).")

        verified_inputs = sum(j.input_star_verified is True for j in star_report.jobs.values())
        lines.append(f"Previous inputs verified: {verified_inputs}/{len(cfg.jobs)} jobs.")
        if star_report.metadata_verified:
            optics = f"groups {star_report.optics_groups}" if star_report.has_optics_block else "no optics blocks or group references"
            lines.append(f"Optics and metadata compatibility: confirmed ({optics}).")
        if star_report.previous_provenance_verified:
            lines.append("Previous provenance: identity coverage and configured source pools confirmed; lineage retained.")
        pending_checks = []
        if star_report.id_columns is None or star_report.unique_particle_ids is None:
            pending_checks.append("particle identity/uniqueness")
        if star_report.optics_groups is None or star_report.has_optics_block is None:
            pending_checks.append("optics compatibility")
        if star_report.all_previous_inputs_verified is not True:
            pending_checks.append("previous inputs for jobs without a verified input_star")
        if star_report.previous_provenance_verified is not True:
            pending_checks.append("previous provenance (not configured; current origins will be recorded)")
        if pending_checks:
            lines.append("")
            lines.append(f"Checks not yet performed: {', '.join(pending_checks)}.")

    lines.append("=" * 72)
    return "\n".join(lines)


def build_parser() -> argparse.ArgumentParser:
    """Build the command-line argument parser."""
    parser = argparse.ArgumentParser(
        prog="class_pool_merge",
        description=(
            "Validate and merge RELION Class3D particle pools across multiple "
            "jobs using a declarative TOML configuration."
        ),
    )
    parser.add_argument(
        "-c",
        "--config",
        type=Path,
        required=True,
        metavar="CONFIG.toml",
        help="Path to the TOML configuration file.",
    )
    parser.add_argument(
        "--project-dir",
        type=Path,
        default=None,
        metavar="DIR",
        help="Override the RELION project root directory.",
    )
    parser.add_argument(
        "-o",
        "--outdir",
        type=Path,
        default=None,
        metavar="DIR",
        help="Override the output directory.",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Validate configuration and inputs without writing output files.",
    )
    parser.add_argument(
        "--allow-unverified-inputs", action="store_true",
        help="Allow output when a job lacks input_star, recording incomplete previous-input verification.",
    )
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    return parser


def main(argv: list[str] | None = None) -> int:
    """CLI entry point."""
    parser = build_parser()
    args = parser.parse_args(argv)

    try:
        cfg = load_config(
            config_path=args.config,
            project_dir_override=args.project_dir,
            outdir_override=args.outdir,
        )
        star_report = validate_star_inputs(cfg)
    except (OSError, ValueError) as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 1

    print(format_validation_summary(cfg, star_report))
    if args.dry_run:
        print("Configuration and STAR input validation succeeded (--dry-run).")
        return 0

    try:
        output = execute_merge(
            cfg, star_report, allow_unverified_inputs=args.allow_unverified_inputs,
            config_path=args.config.resolve(), argv=list(sys.argv[1:] if argv is None else argv),
        )
    except (OSError, ValueError, RuntimeError) as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 1
    print(f"Published validated outputs: {output}")
    if output.is_symlink():
        print(f"Filesystem publication uses a directory symlink; keep {output} and its backing directory {output.resolve()} together.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
