#!/apps/strubi/software/packages/miniforge3/envs/miss-alignment/bin/python
"""
class_pool_merge

Validate and merge RELION Class3D particle pools across multiple jobs using a
declarative TOML configuration.

Phase 2A foundation:
    - CLI argument parsing (--config, --project-dir, --outdir, --dry-run)
    - TOML configuration loading via standard-library tomllib
    - Compact class range and integer list parsing
    - Strict validation of pools, frozen-pool modes, and 1..K class partitions

Developed and maintained by Long Chen.
"""

from __future__ import annotations

import argparse
from dataclasses import dataclass, field
import math
from pathlib import Path
import re
import shlex
import sys
import tomllib
from typing import Any

import pandas as pd
import starfile


VALID_FROZEN_MODES = ("copy_only", "append")
SAFE_NAME_RE = re.compile(r"^[A-Za-z0-9_.-]+$")
RANGE_TOKEN_RE = re.compile(r"^(\d+)(?:\s*-\s*(\d+))?$")
MODEL_CLASS_RE = re.compile(r"class0*(\d+)\.mrc$", re.IGNORECASE)
STRING_ID_COLUMNS = [
    "rlnImageName",
    "rlnTomoParticleName",
    "rlnTomoParticleId",
    "rlnTomoName",
    "rlnMicrographName",
]
AUTO_ID_CANDIDATES: tuple[tuple[str, ...], ...] = (
    ("rlnTomoParticleName",),
    ("rlnTomoName", "rlnTomoParticleId"),
    ("rlnImageName",),
    (
        "rlnTomoName",
        "rlnCenteredCoordinateXAngst",
        "rlnCenteredCoordinateYAngst",
        "rlnCenteredCoordinateZAngst",
    ),
    ("rlnTomoName", "rlnCoordinateX", "rlnCoordinateY", "rlnCoordinateZ"),
    ("rlnMicrographName", "rlnCoordinateX", "rlnCoordinateY", "rlnCoordinateZ"),
)


