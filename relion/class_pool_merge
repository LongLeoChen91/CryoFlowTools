VALID_FROZEN_MODES = ("copy_only", "append")
SAFE_NAME_RE = re.compile(r"^[A-Za-z0-9_.-]+$")
RANGE_TOKEN_RE = re.compile(r"^(\d+)(?:\s*-\s*(\d+))?$")
MODEL_CLASS_RE = re.compile(r"class0*(\d+)\.mrc$", re.IGNORECASE)
