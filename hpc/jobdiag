# 5. SLURM command execution
# ============================================================================


def validate_readonly_command(argv: list[str]) -> None:
    """
    Enforce the strict read-only SLURM operational boundary.
    Raises ValueError if the command is not in the allowed read-only set.
    """
    if not argv:
        raise ValueError("Empty command is not allowed.")

    binary = argv[0].split("/")[-1].strip()

    if binary in FORBIDDEN_COMMANDS:
        raise ValueError(
            f"Forbidden non-read-only SLURM command rejected: {binary}"
        )

    if binary == "scontrol":
        for tok in argv[1:]:
            if tok.lower() in FORBIDDEN_SCONTROL_SUBCOMMANDS:
                raise ValueError(
                    f"Forbidden scontrol operation rejected: scontrol {tok}"
                )

    normalized_head = (binary, *tuple(a.lower() for a in argv[1:]))
    allowed = any(
        normalized_head[: len(prefix)] == prefix
        for prefix in ALLOWED_COMMAND_PREFIXES
    )
    if not allowed:
        raise ValueError(
            f"Command '{' '.join(argv)}' is outside the allowed read-only SLURM commands."
        )


def execute_slurm_command(
    command: str | list[str],
    timeout: float = 15.0,
) -> CommandResult:
    """
    Validate and execute a read-only SLURM command, returning a CommandResult.
    """
    argv = shlex.split(command) if isinstance(command, str) else list(command)
    validate_readonly_command(argv)

    try:
        completed = subprocess.run(
            argv,
            capture_output=True,
            text=True,
            timeout=timeout,
            check=False,
        )
        return CommandResult(
            command=argv,
            returncode=completed.returncode,
            stdout=completed.stdout,
            stderr=completed.stderr,
            ok=(completed.returncode == 0),
            error=(
                completed.stderr.strip()
                if completed.returncode != 0
                else None
            ),
        )
    except FileNotFoundError as exc:
        return CommandResult(
            command=argv,
            returncode=127,
            stdout="",
            stderr=str(exc),
            ok=False,
            error=f"Command not found: {argv[0]}",
        )
    except subprocess.TimeoutExpired as exc:
        return CommandResult(
            command=argv,
            returncode=124,
            stdout=exc.stdout or "" if isinstance(exc.stdout, str) else "",
            stderr=exc.stderr or "" if isinstance(exc.stderr, str) else "",
            ok=False,
            error=f"Command timed out after {timeout}s: {' '.join(argv)}",
        )


