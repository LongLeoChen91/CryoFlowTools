# 9. candidate-node evaluation
# ============================================================================


def _partition_permits_timelimit(
    part: PartitionInfo,
    request: ResourceRequest,
) -> TriState:
    if part.max_time_unlimited:
        return TriState.PASS
    if part.max_time_seconds is not None:
        if request.time_limit_unlimited:
            return TriState.FAIL
        if request.time_limit_seconds is not None:
            return (
                TriState.FAIL
                if request.time_limit_seconds > part.max_time_seconds
                else TriState.PASS
            )
    return TriState.UNKNOWN


def assess_candidate_node(
    request_or_job: ResourceRequest | JobInfo,
    node: NodeInfo,
    partition: PartitionInfo | list[PartitionInfo] | dict[str, PartitionInfo] | None = None,
) -> CandidateNodeAssessment:
    """
    Evaluate a single node against a job resource request in the strict
    11-step order defined by the diagnostic model:
        1. partition membership
        2. required/excluded node
        3. constraints
        4. GPU type
        5. TOTAL GPU capacity
        6. TOTAL CPU capacity
        7. TOTAL memory capacity
        8. node health/state
        9. CURRENT GPU availability
       10. CURRENT CPU availability
       11. CURRENT memory availability
    """
    request = (
        request_or_job.request
        if isinstance(request_or_job, JobInfo)
        else request_or_job
    )

    notes: list[str] = []
    unschedulable_reasons: list[str] = []
    shortage_resources: list[str] = []
    matched_partitions: list[str] = []

    if partition is None:
        parts_list: list[PartitionInfo] = []
    elif isinstance(partition, PartitionInfo):
        parts_list = [partition]
    elif isinstance(partition, dict):
        parts_list = list(partition.values())
    else:
        parts_list = list(partition)

    # 1. Partition membership (and multi-partition per-node TimeLimit policy compatibility)
    partition_fit = TriState.PASS
    if parts_list:
        matching_parts: list[PartitionInfo] = []
        unknown_parts: list[PartitionInfo] = []
        for p in parts_list:
            in_part_nodes = node.name in p.nodes if p.nodes else None
            in_node_parts = p.name in node.partitions if node.partitions else None
            if in_part_nodes is True or in_node_parts is True:
                matching_parts.append(p)
            elif in_part_nodes is None and in_node_parts is None:
                unknown_parts.append(p)

        matched_partitions = [p.name for p in matching_parts]
        if not matching_parts:
            if unknown_parts:
                partition_fit = TriState.UNKNOWN
            else:
                partition_fit = TriState.FAIL
                part_names_str = ", ".join(p.name for p in parts_list)
                notes.append(
                    f"Node {node.name} is not in partition {part_names_str}."
                )
        elif len(parts_list) > 1:
            # In multi-partition mode, if at least one target partition permits TimeLimit
            # but all partition(s) containing this node reject the job's TimeLimit,
            # this node cannot run the job under its partition policy.
            any_target_permits_tl = any(
                _partition_permits_timelimit(p, request) == TriState.PASS
                for p in parts_list
            )
            node_tl_states = [
                _partition_permits_timelimit(p, request) for p in matching_parts
            ]
            if (
                any_target_permits_tl
                and node_tl_states
                and all(s == TriState.FAIL for s in node_tl_states)
            ):
                partition_fit = TriState.FAIL
                p_desc = ", ".join(
                    f"{p.name} (MaxTime={format_duration_seconds(p.max_time_seconds, p.max_time_raw, p.max_time_unlimited)})"
                    for p in matching_parts
                )
                notes.append(
                    f"Node {node.name} only belongs to partition(s) {p_desc} whose MaxTime is shorter than requested TimeLimit."
                )

    # 2. Required / excluded node list
    node_list_fit = TriState.PASS
    if request.exc_nodes and node.name in request.exc_nodes:
        node_list_fit = TriState.FAIL
        notes.append(f"Node {node.name} is excluded by ExcNodeList.")
    elif request.req_nodes and node.name not in request.req_nodes:
        node_list_fit = TriState.FAIL
        notes.append(f"Node {node.name} is not in ReqNodeList.")

    # 3. Feature / constraint requirements
    constraint_fit = TriState.PASS
    if request.constraints:
        if not node.features:
            constraint_fit = TriState.UNKNOWN
            notes.append(f"Node {node.name} features are unknown.")
        else:
            raw_c = (request.constraints_raw or "").strip()
            if "|" in raw_c and "&" not in raw_c:
                if not (request.constraints & node.features):
                    constraint_fit = TriState.FAIL
                    notes.append(
                        f"Node {node.name} does not match any constraint in '{raw_c}'."
                    )
            else:
                missing = request.constraints - node.features
                if missing:
                    constraint_fit = TriState.FAIL
                    notes.append(
                        f"Node {node.name} lacks required feature(s): {', '.join(sorted(missing))}."
                    )

    # 4. GPU type
    gpu_type_fit = TriState.PASS
    if request.gpu_count > 0 and request.gpu_type:
        req_gtype = request.gpu_type.strip().lower()
        node_gtype = (node.gpu_type or "").strip().lower()
        if node.gpu_total == 0:
            gpu_type_fit = TriState.FAIL
            notes.append(f"Node {node.name} has no GPUs (requested {request.gpu_type}).")
        elif not node_gtype and not node.features:
            gpu_type_fit = TriState.UNKNOWN
        else:
            type_tokens = set(re.split(r"[-_:/\s]+", node_gtype)) if node_gtype else set()
            if (
                req_gtype == node_gtype
                or req_gtype in type_tokens
                or req_gtype in node.features
            ):
                gpu_type_fit = TriState.PASS
            else:
                gpu_type_fit = TriState.FAIL
                notes.append(
                    f"Node {node.name} GPU type '{node.gpu_type or 'none'}' does not match requested '{request.gpu_type}'."
                )

    # 5. TOTAL GPU capacity
    total_gpu_fit = TriState.PASS
    if request.gpu_count > 0:
        if node.gpu_total is None:
            total_gpu_fit = TriState.UNKNOWN
        elif node.gpu_total < request.gpu_count:
            total_gpu_fit = TriState.FAIL
            notes.append(
                f"Node {node.name} has {node.gpu_total} total GPU(s), fewer than requested {request.gpu_count}."
            )

    # 6. TOTAL CPU capacity
    total_cpu_fit = TriState.PASS
    if request.cpus is not None and request.cpus > 0:
        if node.cpu_total is None:
            total_cpu_fit = TriState.UNKNOWN
        elif node.cpu_total < request.cpus:
            total_cpu_fit = TriState.FAIL
            notes.append(
                f"Node {node.name} has {node.cpu_total} total CPUs, fewer than requested {request.cpus}."
            )

    # 7. TOTAL memory capacity
    total_memory_fit = TriState.PASS
    if request.memory_mb is not None and request.memory_mb > 0:
        if node.memory_total_mb is None:
            total_memory_fit = TriState.UNKNOWN
        elif node.memory_total_mb < request.memory_mb:
            total_memory_fit = TriState.FAIL
            notes.append(
                f"Node {node.name} has {format_memory_mb(node.memory_total_mb)} total memory, less than requested {format_memory_mb(request.memory_mb)}."
            )

    # Check static eligibility in strict evaluation order (steps 1-7)
    static_checks: list[tuple[TriState, NodeClassification]] = [
        (partition_fit, NodeClassification.INELIGIBLE_PARTITION),
        (node_list_fit, NodeClassification.INELIGIBLE_NODE_LIST),
        (constraint_fit, NodeClassification.INELIGIBLE_CONSTRAINT),
        (gpu_type_fit, NodeClassification.INELIGIBLE_GPU_TYPE),
        (total_gpu_fit, NodeClassification.INELIGIBLE_TOTAL_GPU_CAPACITY),
        (total_cpu_fit, NodeClassification.INELIGIBLE_TOTAL_CPU_CAPACITY),
        (total_memory_fit, NodeClassification.INELIGIBLE_TOTAL_MEMORY_CAPACITY),
    ]

    for check_state, fail_code in static_checks:
        if check_state == TriState.FAIL:
            return CandidateNodeAssessment(
                node_name=node.name,
                node=node,
                statically_eligible=TriState.FAIL,
                fits_now=TriState.FAIL,
                classification=fail_code.value,
                partition_fit=partition_fit,
                node_list_fit=node_list_fit,
                constraint_fit=constraint_fit,
                gpu_type_fit=gpu_type_fit,
                total_gpu_fit=total_gpu_fit,
                total_cpu_fit=total_cpu_fit,
                total_memory_fit=total_memory_fit,
                node_schedulable=TriState.UNKNOWN,
                current_gpu_fit=TriState.UNKNOWN,
                current_cpu_fit=TriState.UNKNOWN,
                current_memory_fit=TriState.UNKNOWN,
                is_planned=("PLANNED" in node.state_flags),
                matched_partitions=matched_partitions,
                unschedulable_reasons=unschedulable_reasons,
                shortage_resources=shortage_resources,
                notes=notes,
            )

    statically_eligible = (
        TriState.UNKNOWN
        if any(s == TriState.UNKNOWN for s, _ in static_checks)
        else TriState.PASS
    )

    # 8. Node health / state
    node_schedulable = TriState.PASS
    is_planned = "PLANNED" in node.state_flags
    hard_flags = sorted(node.state_flags & HARD_UNSCHEDULABLE_STATES)
    if hard_flags:
        node_schedulable = TriState.FAIL
        unschedulable_reasons.extend(hard_flags)
        reason_suffix = f" ({node.reason})" if node.reason else ""
        notes.append(
            f"Node {node.name} is in unschedulable state {node.state_raw}{reason_suffix}."
        )
    elif not node.state_flags or "UNKNOWN" in node.state_flags:
        node_schedulable = TriState.UNKNOWN

    # 9. CURRENT GPU availability
    current_gpu_fit = TriState.PASS
    if request.gpu_count > 0:
        if node.gpu_free is None:
            current_gpu_fit = TriState.UNKNOWN
        elif node.gpu_free < request.gpu_count:
            current_gpu_fit = TriState.FAIL
            shortage_resources.append("GPU")
            notes.append(
                f"Node {node.name} has {node.gpu_free}/{node.gpu_total} free GPU(s); job needs {request.gpu_count}."
            )

    # 10. CURRENT CPU availability
    current_cpu_fit = TriState.PASS
    if request.cpus is not None and request.cpus > 0:
        if node.cpu_free is None:
            current_cpu_fit = TriState.UNKNOWN
        elif node.cpu_free < request.cpus:
            current_cpu_fit = TriState.FAIL
            shortage_resources.append("CPU")
            notes.append(
                f"Node {node.name} has {node.cpu_free}/{node.cpu_total} free CPUs; job needs {request.cpus}."
            )

    # 11. CURRENT memory availability
    current_memory_fit = TriState.PASS
    if request.memory_mb is not None and request.memory_mb > 0:
        if node.memory_free_mb is None:
            current_memory_fit = TriState.UNKNOWN
        elif node.memory_free_mb < request.memory_mb:
            current_memory_fit = TriState.FAIL
            shortage_resources.append("MEMORY")
            notes.append(
                f"Node {node.name} has {format_memory_mb(node.memory_free_mb)} free memory; job needs {format_memory_mb(request.memory_mb)}."
            )

    # Determine Layer 2 classification
    if node_schedulable == TriState.FAIL:
        classification = NodeClassification.ELIGIBLE_NODE_UNSCHEDULABLE.value
        fits_now = TriState.FAIL
    elif len(shortage_resources) > 1:
        classification = NodeClassification.ELIGIBLE_MULTIPLE_SHORTAGES.value
        fits_now = TriState.FAIL
    elif shortage_resources == ["GPU"]:
        classification = NodeClassification.ELIGIBLE_GPU_SHORTAGE.value
        fits_now = TriState.FAIL
    elif shortage_resources == ["CPU"]:
        classification = NodeClassification.ELIGIBLE_CPU_SHORTAGE.value
        fits_now = TriState.FAIL
    elif shortage_resources == ["MEMORY"]:
        classification = NodeClassification.ELIGIBLE_MEMORY_SHORTAGE.value
        fits_now = TriState.FAIL
    elif any(
        c == TriState.UNKNOWN
        for c in (current_gpu_fit, current_cpu_fit, current_memory_fit)
    ):
        fits_now = TriState.UNKNOWN
        classification = (
            NodeClassification.ELIGIBLE_PLANNED_REVIEW_REQUIRED.value
            if is_planned
            else NodeClassification.ELIGIBLE_FITS_NOW.value
        )
    elif is_planned:
        fits_now = TriState.PASS
        classification = (
            NodeClassification.ELIGIBLE_PLANNED_REVIEW_REQUIRED.value
        )
    else:
        fits_now = TriState.PASS
        classification = NodeClassification.ELIGIBLE_FITS_NOW.value

    return CandidateNodeAssessment(
        node_name=node.name,
        node=node,
        statically_eligible=statically_eligible,
        fits_now=fits_now,
        classification=classification,
        partition_fit=partition_fit,
        node_list_fit=node_list_fit,
        constraint_fit=constraint_fit,
        gpu_type_fit=gpu_type_fit,
        total_gpu_fit=total_gpu_fit,
        total_cpu_fit=total_cpu_fit,
        total_memory_fit=total_memory_fit,
        node_schedulable=node_schedulable,
        current_gpu_fit=current_gpu_fit,
        current_cpu_fit=current_cpu_fit,
        current_memory_fit=current_memory_fit,
        is_planned=is_planned,
        matched_partitions=matched_partitions,
        unschedulable_reasons=unschedulable_reasons,
        shortage_resources=shortage_resources,
        notes=notes,
    )


