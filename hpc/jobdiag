CommandRunner = Callable[[str | list[str]], CommandResult]


def compare_job_snapshots(job_a: JobInfo, job_b: JobInfo) -> list[str]:
    """
    Compare scheduling-relevant fields between two snapshots of the target job.
    Returns the list of SLURM field names that changed.
    """
    changed: list[str] = []
    mapping = {
        "JobState": (job_a.state, job_b.state),
        "Reason": (job_a.reason, job_b.reason),
        "StartTime": (job_a.start_time_raw, job_b.start_time_raw),
        "SchedNodeList": (job_a.sched_node_list_raw, job_b.sched_node_list_raw),
        "NodeList": (job_a.node_list_raw, job_b.node_list_raw),
        "Priority": (job_a.priority, job_b.priority),
        "ReqTRES": (job_a.req_tres_raw, job_b.req_tres_raw),
        "TimeLimit": (
            job_a.request.time_limit_raw,
            job_b.request.time_limit_raw,
        ),
    }
    for field_name in SNAPSHOT_COMPARE_FIELDS:
        val_a, val_b = mapping[field_name]
        if val_a != val_b:
            changed.append(field_name)
    return changed


def acquire_job_snapshot(
    job_id: str,
    runner: CommandRunner = execute_slurm_command,
    commands_run: list[str] | None = None,
) -> tuple[JobInfo | None, str | None]:
    cmd = f"scontrol show job {shlex.quote(str(job_id))}"
    if commands_run is not None:
        commands_run.append(cmd)
    res = runner(cmd)
    if not res.ok or not res.stdout.strip():
        return None, res.error or f"Could not retrieve job {job_id}"
    job = parse_job_info(res.stdout)
    if not job.job_id:
        return None, f"Could not parse job information for {job_id}"
    return job, None


def acquire_partition(
    partition_name: str,
    runner: CommandRunner = execute_slurm_command,
    commands_run: list[str] | None = None,
) -> tuple[PartitionInfo | None, str | None]:
    cmd = f"scontrol show partition {shlex.quote(partition_name)}"
    if commands_run is not None:
        commands_run.append(cmd)
    res = runner(cmd)
    if not res.ok or not res.stdout.strip():
        return None, res.error or f"Could not retrieve partition '{partition_name}'"
    part = parse_partition_info(res.stdout)
    if not part.name:
        return None, f"Partition '{partition_name}' not found."
    return part, None


def acquire_partition_nodes(
    partition_name: str,
    partition_info: PartitionInfo | None,
    runner: CommandRunner = execute_slurm_command,
    commands_run: list[str] | None = None,
    warnings: list[str] | None = None,
) -> list[str]:
    cmd = f"sinfo -p {shlex.quote(partition_name)} -N"
    if commands_run is not None:
        commands_run.append(cmd)
    res = runner(cmd)
    nodes: list[str] = []
    if res.ok and res.stdout.strip():
        nodes = parse_sinfo_nodes(res.stdout)
    elif warnings is not None and res.error:
        warnings.append(f"sinfo node enumeration warning: {res.error}")

    if partition_info and partition_info.nodes:
        seen = set(nodes)
        for n in partition_info.nodes:
            if n not in seen:
                seen.add(n)
                nodes.append(n)
    return nodes


def acquire_nodes_details(
    node_names: list[str],
    runner: CommandRunner = execute_slurm_command,
    commands_run: list[str] | None = None,
    warnings: list[str] | None = None,
) -> dict[str, NodeInfo]:
    if not node_names:
        return {}
    nodelist_csv = ",".join(node_names)
    cmd = f"scontrol show node {shlex.quote(nodelist_csv)}"
    if commands_run is not None:
        commands_run.append(cmd)
    res = runner(cmd)
    if not res.ok or not res.stdout.strip():
        if warnings is not None and res.error:
            warnings.append(f"Node detail query warning: {res.error}")
        return {}
    return parse_nodes_output(res.stdout)


