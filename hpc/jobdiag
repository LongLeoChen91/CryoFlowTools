_MEM_RE = re.compile(
    r"^\s*(\d+(?:\.\d+)?)\s*([KMGTPE]?)(?:I?B)?\s*$",
    re.IGNORECASE,
)


def parse_memory(value: str | None) -> int | None:
    """
    Parse a SLURM memory string into normalized integer MiB (MB).

    Supports suffixes K, M, G, T (case-insensitive) and bare integers
    (which SLURM uses for MiB in RealMemory, AllocMem, etc.).
    Returns None on missing, unknown, or unparseable values.
    Never returns a fake 0 on parse failure.
    """
    if value is None:
        return None
    stripped = value.strip()
    if is_null_value(stripped):
        return None
    if stripped.upper() in {"UNLIMITED", "INFINITE", "NONE"}:
        return None

    match = _MEM_RE.match(stripped)
    if not match:
        return None

    amount_str, unit = match.groups()
    try:
        amount = float(amount_str)
    except ValueError:
        return None

    if amount < 0:
        return None

    unit_u = unit.upper()
    if unit_u in ("", "M"):
        return int(round(amount))
    if unit_u == "K":
        if amount == 0:
            return 0
        return max(1, int(round(amount / 1024.0)))
    if unit_u == "G":
        return int(round(amount * 1024.0))
    if unit_u == "T":
        return int(round(amount * 1024.0 * 1024.0))
    if unit_u == "P":
        return int(round(amount * 1024.0 * 1024.0 * 1024.0))
    return None


def is_unlimited_duration(value: str | None) -> bool:
    if value is None:
        return False
    return value.strip().upper() in {"UNLIMITED", "INFINITE"}


def parse_duration(value: str | None) -> int | None:
    """
    Parse a SLURM duration string into total integer seconds.

    Supported formats:
        MM:SS
        HH:MM:SS
        D-HH:MM:SS
        D-HH:MM
        D-HH
        UNLIMITED / N/A / Unknown -> None
    """
    if value is None:
        return None
    stripped = value.strip()
    if is_null_value(stripped) or is_unlimited_duration(stripped):
        return None

    days = 0
    time_part = stripped
    if "-" in stripped:
        day_str, time_part = stripped.split("-", 1)
        if not day_str.isdigit():
            return None
        days = int(day_str)

    segments = time_part.split(":")
    if not all(seg.isdigit() for seg in segments):
        return None

    if len(segments) == 1:
        if "-" in stripped:
            # D-HH
            hours = int(segments[0])
            return days * 86400 + hours * 3600
        # Bare minutes
        minutes = int(segments[0])
        return minutes * 60

    if len(segments) == 2:
        if "-" in stripped:
            # D-HH:MM
            hours, minutes = int(segments[0]), int(segments[1])
            if minutes >= 60:
                return None
            return days * 86400 + hours * 3600 + minutes * 60
        # MM:SS
        minutes, seconds = int(segments[0]), int(segments[1])
        if seconds >= 60:
            return None
        return minutes * 60 + seconds

    if len(segments) == 3:
        hours, minutes, seconds = (
            int(segments[0]),
            int(segments[1]),
            int(segments[2]),
        )
        if minutes >= 60 or seconds >= 60:
            return None
        return days * 86400 + hours * 3600 + minutes * 60 + seconds

    return None


def parse_slurm_datetime(value: str | None) -> datetime | None:
    """
    Parse a SLURM datetime string such as '2026-11-04T19:42:29' into a datetime.
    Returns None for Unknown, None, N/A, (null), or invalid timestamps.
    """
    if value is None:
        return None
    stripped = value.strip()
    if is_null_value(stripped):
        return None

    for fmt in (
        "%Y-%m-%dT%H:%M:%S",
        "%Y-%m-%d %H:%M:%S",
        "%Y-%m-%dT%H:%M",
        "%Y-%m-%d %H:%M",
        "%Y-%m-%d",
    ):
        try:
            return datetime.strptime(stripped, fmt)
        except ValueError:
            continue

    try:
        return datetime.fromisoformat(stripped)
    except ValueError:
        return None


def parse_tres(tres_string: str | None) -> dict[str, Any]:
    """
    Parse a SLURM TRES string (e.g., 'cpu=12,mem=144G,node=1,billing=90,gres/gpu=1').

    Returns a normalized dictionary:
        {
            "cpu": int | None,
            "mem_mb": int | None,
            "mem_raw": str | None,
            "node": int | None,
            "billing": int | None,
            "gpu_count": int,
            "gpu_type": str | None,
            "entries": dict[str, str],
        }
    """
    result: dict[str, Any] = {
        "cpu": None,
        "mem_mb": None,
        "mem_raw": None,
        "node": None,
        "billing": None,
        "gpu_count": 0,
        "gpu_type": None,
        "entries": {},
    }
    if is_null_value(tres_string):
        return result

    assert tres_string is not None
    generic_gpu_count: int | None = None
    typed_gpu_counts: dict[str, int] = {}

    for part in tres_string.strip().split(","):
        part = part.strip()
        if not part or "=" not in part:
            continue
        key, val = part.split("=", 1)
        key = key.strip()
        val = val.strip()
        result["entries"][key] = val

        key_lower = key.lower()
        if key_lower == "cpu":
            if val.isdigit():
                result["cpu"] = int(val)
        elif key_lower == "mem":
            result["mem_raw"] = val
            result["mem_mb"] = parse_memory(val)
        elif key_lower == "node":
            if val.isdigit():
                result["node"] = int(val)
        elif key_lower == "billing":
            if val.isdigit():
                result["billing"] = int(val)
        elif key_lower == "gres/gpu":
            if val.isdigit():
                generic_gpu_count = int(val)
        elif key_lower.startswith("gres/gpu:"):
            gtype = key.split(":", 1)[1].strip()
            if val.isdigit():
                typed_gpu_counts[gtype] = int(val)
            elif gtype:
                result["gpu_type"] = gtype

    if typed_gpu_counts:
        # Preserve GPU type from typed TRES entry
        first_type = next(iter(typed_gpu_counts.keys()))
        result["gpu_type"] = first_type
        if generic_gpu_count is not None:
            result["gpu_count"] = generic_gpu_count
        else:
            result["gpu_count"] = sum(typed_gpu_counts.values())
    elif generic_gpu_count is not None:
        result["gpu_count"] = generic_gpu_count

    return result


def parse_state_flags(state_string: str | None) -> set[str]:
    """
    Parse a SLURM node state string such as 'IDLE+DRAIN' or
    'DOWN+DRAIN+NOT_RESPONDING' into normalized uppercase flag tokens.

    Trailing SLURM state symbols (*, ~, #, $, @, -, %) are stripped from
    individual tokens while preserving all state words.
    """
    if is_null_value(state_string):
        return set()
    assert state_string is not None
    flags: set[str] = set()
    for raw_tok in re.split(r"[+,|\s]+", state_string.strip()):
        cleaned = raw_tok.strip().rstrip("*~#$@-%").upper()
        if cleaned:
            flags.add(cleaned)
    return flags


_KV_KEY_RE = re.compile(r"(?<!\S)([A-Za-z0-9_/:.-]+)=")


def parse_scontrol_kv_block(block: str) -> dict[str, str]:
    """
    Parse a single-record block from `scontrol show <entity>` into a dictionary
    of key -> raw value string, preserving full node/job reasons and TRES fields.
    """
    fields: dict[str, str] = {}
    for raw_line in block.splitlines():
        line = raw_line.strip()
        if not line:
            continue
        # In `scontrol show node`, Reason=... occupies the remainder of the line
        # and may contain brackets, timestamps, or '=' signs.
        if line.startswith("Reason=") and "JobState=" not in line:
            fields["Reason"] = line[len("Reason=") :].strip()
            continue

        matches = list(_KV_KEY_RE.finditer(line))
        for idx, match in enumerate(matches):
            key = match.group(1)
            val_start = match.end()
            val_end = (
                matches[idx + 1].start()
                if idx + 1 < len(matches)
                else len(line)
            )
            value = line[val_start:val_end].strip()
            fields[key] = value
    return fields


def parse_scontrol_blocks(output: str) -> list[dict[str, str]]:
    """
    Split multi-record `scontrol show` output into blocks and parse each block.
    """
    if not output or not output.strip():
        return []

    blocks: list[list[str]] = []
    current: list[str] = []
    record_Start_Prefixes = (
        "JobId=",
        "NodeName=",
        "PartitionName=",
        "ReservationName=",
    )

    for line in output.splitlines():
        stripped = line.strip()
        if not stripped:
            if current:
                blocks.append(current)
                current = []
            continue
        if current and any(
            stripped.startswith(pref) for pref in record_Start_Prefixes
        ):
            blocks.append(current)
            current = [line]
        else:
            current.append(line)

    if current:
        blocks.append(current)

    parsed: list[dict[str, str]] = []
    for blk in blocks:
        kv = parse_scontrol_kv_block("\n".join(blk))
        if kv:
            parsed.append(kv)
    return parsed


# ============================================================================
# 7. normalization helpers
# ============================================================================


def _parse_gres_spec(gres_raw: str | None) -> tuple[int | None, str | None]:
    """
    Parse a SLURM Gres / TresPerNode specification such as:
        'gpu:a100-pcie-80gb:4'
        'gpu:a100:2(S:0-1)'
        'gres/gpu:a100:2'
        'gres/gpu:1'
        'gpu:4'
    Returns (gpu_count, gpu_type).
    """
    if is_null_value(gres_raw):
        return None, None
    assert gres_raw is not None

    for item in gres_raw.strip().split(","):
        # Remove parenthetical socket/index annotations like (IDX:0-3) or (S:0)
        cleaned = re.sub(r"\([^)]*\)", "", item).strip()
        if not cleaned:
            continue
        if cleaned.lower().startswith("gres/"):
            cleaned = cleaned[5:]
        if not cleaned.lower().startswith("gpu"):
            continue
        parts = cleaned.split(":")
        # 'gpu' alone
        if len(parts) == 1:
            return 1, None
        # 'gpu:4' or 'gpu:a100'
        if len(parts) == 2:
            if parts[1].isdigit():
                return int(parts[1]), None
            return 1, parts[1] or None
        # 'gpu:a100-pcie-80gb:4'
        if len(parts) >= 3:
            gtype = parts[1].strip() or None
            count_str = parts[2].strip()
            count = int(count_str) if count_str.isdigit() else None
            return count, gtype

    return None, None


def _parse_constraints(features_raw: str | None) -> set[str]:
    if is_null_value(features_raw):
        return set()
    assert features_raw is not None
    tokens: set[str] = set()
    for tok in re.split(r"[&|,\s()\[\]]+", features_raw.strip()):
        cleaned = tok.strip()
        if cleaned and not is_null_value(cleaned):
            tokens.add(cleaned.lower())
    return tokens


def parse_job_info(text_or_fields: str | dict[str, str]) -> JobInfo:
    """
    Normalize a `scontrol show job` record into a JobInfo object.
    """
    if isinstance(text_or_fields, str):
        blocks = parse_scontrol_blocks(text_or_fields)
        fields = blocks[0] if blocks else parse_scontrol_kv_block(text_or_fields)
    else:
        fields = dict(text_or_fields)

    job_id = str(fields.get("JobId", "")).strip()
    name = fields.get("JobName", fields.get("Name", "")).strip()

    user_raw = fields.get("UserId", "").strip()
    user = user_raw.split("(", 1)[0].strip() if user_raw else ""

    account = fields.get("Account", "").strip()
    qos = fields.get("QOS", fields.get("QoS", "")).strip()
    partition = fields.get("Partition", "").strip()
    state = fields.get("JobState", "").strip()
    reason = fields.get("Reason", "").strip()

    prio_raw = fields.get("Priority", "").strip()
    priority = int(prio_raw) if prio_raw.isdigit() else None

    submit_raw = fields.get("SubmitTime")
    start_raw = fields.get("StartTime")
    end_raw = fields.get("EndTime")
    run_time_raw = fields.get("RunTime")
    time_limit_raw = fields.get("TimeLimit")

    req_tres_raw = fields.get("ReqTRES")
    alloc_tres_raw = fields.get("AllocTRES")

    req_tres = parse_tres(req_tres_raw)
    alloc_tres = parse_tres(alloc_tres_raw)

    # Nodes count
    nodes_count = 1
    num_nodes_raw = fields.get("NumNodes", "").strip()
    if num_nodes_raw:
        first_num = num_nodes_raw.split("-", 1)[0].strip()
        if first_num.isdigit():
            nodes_count = int(first_num)
    elif req_tres["node"] is not None:
        nodes_count = req_tres["node"]

    # CPUs
    cpus: int | None = req_tres["cpu"]
    if cpus is None:
        num_cpus_raw = fields.get("NumCPUs", "").strip()
        if num_cpus_raw.isdigit():
            cpus = int(num_cpus_raw)
        elif alloc_tres["cpu"] is not None:
            cpus = alloc_tres["cpu"]

    # Memory semantics (Section 14):
    # Prefer total memory from ReqTRES mem= when available.
    min_mem_node_raw = fields.get("MinMemoryNode")
    min_mem_cpu_raw = fields.get("MinMemoryCPU")
    min_mem_tres_raw = fields.get("MinMemoryTRES")

    memory_mb: int | None = req_tres["mem_mb"]
    memory_raw: str | None = req_tres["mem_raw"]

    if memory_mb is None and alloc_tres["mem_mb"] is not None:
        memory_mb = alloc_tres["mem_mb"]
        memory_raw = alloc_tres["mem_raw"]

    if memory_mb is None:
        if not is_null_value(min_mem_node_raw):
            memory_mb = parse_memory(min_mem_node_raw)
            memory_raw = min_mem_node_raw
        elif not is_null_value(min_mem_cpu_raw) and cpus is not None:
            per_cpu = parse_memory(min_mem_cpu_raw)
            if per_cpu is not None:
                memory_mb = per_cpu * cpus
                memory_raw = f"{min_mem_cpu_raw}/cpu"

    # GPU semantics (Section 15):
    gpu_count = req_tres["gpu_count"]
    gpu_type = req_tres["gpu_type"]

    for gres_field in ("TresPerNode", "ReqGres", "Gres"):
        gres_val = fields.get(gres_field)
        if not is_null_value(gres_val):
            g_cnt, g_type = _parse_gres_spec(gres_val)
            if gpu_count == 0 and g_cnt is not None:
                gpu_count = g_cnt
            if gpu_type is None and g_type is not None:
                gpu_type = g_type

    if gpu_count == 0 and alloc_tres["gpu_count"] > 0:
        gpu_count = alloc_tres["gpu_count"]
        if gpu_type is None:
            gpu_type = alloc_tres["gpu_type"]

    # If still no memory_mb and MinMemoryTRES is present with GPUs
    if memory_mb is None and not is_null_value(min_mem_tres_raw) and gpu_count > 0:
        per_gpu = parse_memory(min_mem_tres_raw)
        if per_gpu is not None:
            memory_mb = per_gpu * gpu_count
            memory_raw = min_mem_tres_raw

    req_nodes_raw = fields.get("ReqNodeList")
    exc_nodes_raw = fields.get("ExcNodeList")
    features_raw = fields.get("Features")

    request = ResourceRequest(
        cpus=cpus,
        memory_mb=memory_mb,
        memory_raw=memory_raw,
        nodes=nodes_count,
        gpu_count=gpu_count,
        gpu_type=gpu_type,
        time_limit_seconds=parse_duration(time_limit_raw),
        time_limit_raw=time_limit_raw,
        time_limit_unlimited=is_unlimited_duration(time_limit_raw),
        constraints=_parse_constraints(features_raw),
        constraints_raw=None if is_null_value(features_raw) else features_raw,
        req_nodes=set(expand_nodelist(req_nodes_raw)),
        req_nodes_raw=None if is_null_value(req_nodes_raw) else req_nodes_raw,
        exc_nodes=set(expand_nodelist(exc_nodes_raw)),
        exc_nodes_raw=None if is_null_value(exc_nodes_raw) else exc_nodes_raw,
        min_memory_node_raw=(
            None if is_null_value(min_mem_node_raw) else min_mem_node_raw
        ),
        min_memory_cpu_raw=(
            None if is_null_value(min_mem_cpu_raw) else min_mem_cpu_raw
        ),
        min_memory_tres_raw=(
            None if is_null_value(min_mem_tres_raw) else min_mem_tres_raw
        ),
    )

    node_list_raw = fields.get("NodeList")
    sched_node_list_raw = fields.get("SchedNodeList")
    dep_raw = fields.get("Dependency")
    dependency_raw = None if is_null_value(dep_raw) else dep_raw.strip()

    allocated_gpus: int | None = None
    allocated_gpu_type: str | None = None
    allocated_cpus: int | None = None
    allocated_memory_mb: int | None = None
    if alloc_tres["entries"]:
        allocated_gpus = alloc_tres["gpu_count"]
        allocated_gpu_type = alloc_tres["gpu_type"] or gpu_type
        allocated_cpus = alloc_tres["cpu"]
        allocated_memory_mb = alloc_tres["mem_mb"]

    return JobInfo(
        job_id=job_id,
        name=name,
        user=user,
        account=account,
        qos=qos,
        partition=partition,
        partitions=parse_partition_list(partition),
        state=state,
        reason=reason,
        priority=priority,
        submit_time=parse_slurm_datetime(submit_raw),
        submit_time_raw=submit_raw,
        start_time=parse_slurm_datetime(start_raw),
        start_time_raw=start_raw,
        end_time=parse_slurm_datetime(end_raw),
        end_time_raw=end_raw,
        run_time_seconds=parse_duration(run_time_raw),
        run_time_raw=run_time_raw,
        node_list=expand_nodelist(node_list_raw),
        node_list_raw=None if is_null_value(node_list_raw) else node_list_raw,
        sched_node_list=expand_nodelist(sched_node_list_raw),
        sched_node_list_raw=(
            None if is_null_value(sched_node_list_raw) else sched_node_list_raw
        ),
        dependency_raw=dependency_raw,
        req_tres_raw=req_tres_raw,
        alloc_tres_raw=alloc_tres_raw,
        allocated_gpus=allocated_gpus,
        allocated_gpu_type=allocated_gpu_type,
        allocated_cpus=allocated_cpus,
        allocated_memory_mb=allocated_memory_mb,
        request=request,
        raw_fields=fields,
    )


def parse_node_info(text_or_fields: str | dict[str, str]) -> NodeInfo:
    """
    Normalize a single `scontrol show node` record into a NodeInfo object.

    Preserves complete node states (including +DRAIN, +PLANNED, etc.) and uses
    Tri-state / None on parse failures rather than fake zeros.
    """
    if isinstance(text_or_fields, str):
        blocks = parse_scontrol_blocks(text_or_fields)
        fields = blocks[0] if blocks else parse_scontrol_kv_block(text_or_fields)
    else:
        fields = dict(text_or_fields)

    raw_name = fields.get("NodeName", "")
    name = normalize_node_name(raw_name)

    state_raw = fields.get("State", "UNKNOWN").strip() or "UNKNOWN"
    state_flags = parse_state_flags(state_raw)

    reason_raw = fields.get("Reason")
    reason = None if is_null_value(reason_raw) else reason_raw

    partitions_raw = fields.get("Partitions", "")
    partitions = {
        p.strip()
        for p in partitions_raw.split(",")
        if p.strip() and not is_null_value(p)
    }

    cpu_tot_raw = fields.get("CPUTot")
    cpu_alloc_raw = fields.get("CPUAlloc")
    cpu_load_raw = fields.get("CPULoad")

    cpu_total = (
        int(cpu_tot_raw.strip())
        if cpu_tot_raw is not None and cpu_tot_raw.strip().isdigit()
        else None
    )
    cpu_alloc = (
        int(cpu_alloc_raw.strip())
        if cpu_alloc_raw is not None and cpu_alloc_raw.strip().isdigit()
        else None
    )

    cpu_load: float | None = None
    if cpu_load_raw is not None and not is_null_value(cpu_load_raw):
        try:
            cpu_load = float(cpu_load_raw.strip())
        except ValueError:
            cpu_load = None

    real_mem_raw = fields.get("RealMemory")
    alloc_mem_raw = fields.get("AllocMem")
    memory_total_mb = parse_memory(real_mem_raw)
    memory_alloc_mb = parse_memory(alloc_mem_raw)

    gres_raw = fields.get("Gres")
    cfg_tres_raw = fields.get("CfgTRES")
    alloc_tres_raw = fields.get("AllocTRES")

    gres_count, gres_type = _parse_gres_spec(gres_raw)
    cfg_tres = parse_tres(cfg_tres_raw)
    alloc_tres = parse_tres(alloc_tres_raw)

    gpu_type = gres_type or cfg_tres["gpu_type"] or alloc_tres["gpu_type"]

    # Derive gpu_total, gpu_allocated, gpu_free
    gpu_total: int | None = None
    if cfg_tres_raw is not None and not is_null_value(cfg_tres_raw):
        if cfg_tres["entries"]:
            gpu_total = cfg_tres["gpu_count"]
    elif gres_count is not None:
        gpu_total = gres_count
    elif gres_raw is not None and gres_raw.strip().lower() in {"(null)", "none"}:
        gpu_total = 0

    gpu_allocated: int | None = None
    if "AllocTRES" in fields:
        # Note: on IDLE nodes in SLURM, 'AllocTRES=' is empty, meaning 0 allocated TRES.
        raw_at = fields["AllocTRES"].strip()
        if raw_at == "" or raw_at.lower() in {"(null)", "none"}:
            gpu_allocated = 0
        elif alloc_tres["entries"]:
            gpu_allocated = alloc_tres["gpu_count"]
    elif gpu_total == 0:
        gpu_allocated = 0

    gpu_free: int | None = None
    if gpu_total is not None and gpu_allocated is not None:
        gpu_free = max(0, gpu_total - gpu_allocated)

    features: set[str] = set()
    for feat_key in ("ActiveFeatures", "AvailableFeatures", "Features"):
        f_raw = fields.get(feat_key)
        if not is_null_value(f_raw):
            assert f_raw is not None
            for tok in f_raw.split(","):
                tok_clean = tok.strip().lower()
                if tok_clean:
                    features.add(tok_clean)

    return NodeInfo(
        name=name,
        state_raw=state_raw,
        state_flags=state_flags,
        reason=reason,
        partitions=partitions,
        cpu_total=cpu_total,
        cpu_alloc=cpu_alloc,
        cpu_load=cpu_load,
        cpu_load_raw=cpu_load_raw,
        memory_total_mb=memory_total_mb,
        memory_alloc_mb=memory_alloc_mb,
        gpu_total=gpu_total,
        gpu_allocated=gpu_allocated,
        gpu_free=gpu_free,
        gpu_type=gpu_type,
        gres_raw=gres_raw,
        cfg_tres_raw=cfg_tres_raw,
        alloc_tres_raw=alloc_tres_raw,
        features=features,
        raw_fields=fields,
    )


def parse_nodes_output(output: str) -> dict[str, NodeInfo]:
    nodes: dict[str, NodeInfo] = {}
    for block_fields in parse_scontrol_blocks(output):
        if "NodeName" not in block_fields:
            continue
        node = parse_node_info(block_fields)
        if node.name:
            nodes[node.name] = node
    return nodes


def _parse_policy_set(raw: str | None) -> set[str] | None:
    if is_null_value(raw):
        return None
    assert raw is not None
    items = {
        tok.strip().lower()
        for tok in raw.split(",")
        if tok.strip() and not is_null_value(tok)
    }
    if not items:
        return None
    if "all" in items:
        return {"ALL"}
    return items


def parse_partition_info(text_or_fields: str | dict[str, str]) -> PartitionInfo:
    """
    Normalize `scontrol show partition` output into a PartitionInfo object.
    """
    if isinstance(text_or_fields, str):
        blocks = parse_scontrol_blocks(text_or_fields)
        fields = blocks[0] if blocks else parse_scontrol_kv_block(text_or_fields)
    else:
        fields = dict(text_or_fields)

    name = fields.get("PartitionName", "").strip()
    state = fields.get("State", "UP").strip()
    max_time_raw = fields.get("MaxTime")
    max_time_unlimited = is_unlimited_duration(max_time_raw)
    max_time_seconds = parse_duration(max_time_raw)

    max_nodes_raw = fields.get("MaxNodes", "").strip()
    max_nodes = int(max_nodes_raw) if max_nodes_raw.isdigit() else None

    max_cpus_raw = fields.get("MaxCPUsPerNode", "").strip()
    max_cpus_per_node = int(max_cpus_raw) if max_cpus_raw.isdigit() else None

    max_mem_raw = fields.get("MaxMemPerNode")
    max_mem_per_node_mb = parse_memory(max_mem_raw)

    allow_accounts = _parse_policy_set(fields.get("AllowAccounts"))
    deny_accounts_set = _parse_policy_set(fields.get("DenyAccounts")) or set()
    deny_accounts = (
        set() if "ALL" in deny_accounts_set else deny_accounts_set
    )

    allow_qos = _parse_policy_set(fields.get("AllowQos", fields.get("AllowQOS")))
    deny_qos_set = (
        _parse_policy_set(fields.get("DenyQos", fields.get("DenyQOS"))) or set()
    )
    deny_qos = set() if "ALL" in deny_qos_set else deny_qos_set

    nodes_raw = fields.get("Nodes")
    nodes = expand_nodelist(nodes_raw)
    qos = fields.get("QoS", fields.get("QOS"))

    return PartitionInfo(
        name=name,
        state=state,
        max_time_seconds=max_time_seconds,
        max_time_raw=max_time_raw,
        max_time_unlimited=max_time_unlimited,
        max_nodes=max_nodes,
        max_cpus_per_node=max_cpus_per_node,
        max_mem_per_node_mb=max_mem_per_node_mb,
        allow_accounts=allow_accounts,
        deny_accounts=deny_accounts,
        allow_qos=allow_qos,
        deny_qos=deny_qos,
        nodes=nodes,
        nodes_raw=nodes_raw,
        qos=None if is_null_value(qos) else qos,
        raw_fields=fields,
    )


def parse_reservation_info(
    text_or_fields: str | dict[str, str]
) -> ReservationInfo:
    """
    Normalize a single `scontrol show reservation` record into a ReservationInfo.
    """
    if isinstance(text_or_fields, str):
        blocks = parse_scontrol_blocks(text_or_fields)
        fields = blocks[0] if blocks else parse_scontrol_kv_block(text_or_fields)
    else:
        fields = dict(text_or_fields)

    name = fields.get("ReservationName", "").strip()
    start_raw = fields.get("StartTime")
    end_raw = fields.get("EndTime")
    nodes_raw = fields.get("Nodes")
    state = fields.get("State", "").strip()

    flags_raw = fields.get("Flags", "")
    flags = (
        {
            f.strip().upper()
            for f in flags_raw.split(",")
            if f.strip() and not is_null_value(f)
        }
        if not is_null_value(flags_raw)
        else set()
    )

    users_raw = fields.get("Users", "")
    users = (
        {
            u.strip().lower()
            for u in users_raw.split(",")
            if u.strip() and not is_null_value(u)
        }
        if not is_null_value(users_raw)
        else set()
    )

    accounts_raw = fields.get("Accounts", "")
    accounts = (
        {
            a.strip().lower()
            for a in accounts_raw.split(",")
            if a.strip() and not is_null_value(a)
        }
        if not is_null_value(accounts_raw)
        else set()
    )

    part_raw = fields.get("PartitionName")
    partition = None if is_null_value(part_raw) else part_raw

    return ReservationInfo(
        name=name,
        start_time=parse_slurm_datetime(start_raw),
        end_time=parse_slurm_datetime(end_raw),
        start_time_raw=start_raw,
        end_time_raw=end_raw,
        nodes=set(expand_nodelist(nodes_raw)),
        nodes_raw=nodes_raw,
        state=state,
        flags=flags,
        users=users,
        accounts=accounts,
        partition=partition,
        tres_raw=fields.get("TRES"),
        raw_fields=fields,
    )


def parse_reservations_output(output: str) -> list[ReservationInfo]:
    reservations: list[ReservationInfo] = []
    for block_fields in parse_scontrol_blocks(output):
        if "ReservationName" not in block_fields:
            continue
        resv = parse_reservation_info(block_fields)
        if resv.name:
            reservations.append(resv)
    return reservations


def parse_priority_info(output: str, target_job_id: str = "") -> PriorityInfo | None:
    """
    Parse `sprio -j JOBID` tabular output into PriorityInfo.
    """
    lines = [ln.strip() for ln in output.splitlines() if ln.strip()]
    if not lines:
        return None

    headers: list[str] = []
    for line in lines:
        tokens = line.split()
        if not tokens:
            continue
        if tokens[0].upper() == "JOBID":
            headers = [t.upper() for t in tokens]
            continue
        if headers and len(tokens) == len(headers):
            row = dict(zip(headers, tokens))
        elif len(tokens) >= 3 and tokens[0].isdigit():
            # Fallback positional: JOBID PARTITION PRIORITY [SITE] [AGE] [FAIRSHARE] [QOS]
            cols = ["JOBID", "PARTITION", "PRIORITY", "SITE", "AGE", "FAIRSHARE", "QOS"]
            row = dict(zip(cols[: len(tokens)], tokens))
        else:
            continue

        jid = row.get("JOBID", "").strip()
        if target_job_id and jid and jid != target_job_id:
            continue

        def _to_int(key: str) -> int | None:
            v = row.get(key, "").strip()
            return int(v) if v.lstrip("-").isdigit() else None

        return PriorityInfo(
            job_id=jid or target_job_id,
            partition=row.get("PARTITION", ""),
            priority=_to_int("PRIORITY"),
            site=_to_int("SITE"),
            age=_to_int("AGE"),
            fairshare=_to_int("FAIRSHARE"),
            qos=_to_int("QOS"),
            raw_fields=row,
        )

    return None


def parse_sinfo_nodes(output: str) -> list[str]:
    """
    Parse `sinfo -p PARTITION -N` output (with or without header) into a list
    of unique normalized node names.
    """
    nodes: list[str] = []
    seen: set[str] = set()
    for line in output.splitlines():
        stripped = line.strip()
        if not stripped:
            continue
        tokens = stripped.split()
        first = tokens[0]
        if first.upper() in {"NODELIST", "NODE", "HOSTNAMES"}:
            continue
        for node in expand_nodelist(first):
            if node and node not in seen:
                seen.add(node)
                nodes.append(node)
    return nodes


def parse_squeue_start(output: str, target_job_id: str = "") -> dict[str, str]:
    """
    Parse `squeue --start -j JOBID` output into a dict with keys
    'start_time' and 'sched_nodes' when available.
    """
    info: dict[str, str] = {}
    lines = [ln.strip() for ln in output.splitlines() if ln.strip()]
    for line in lines:
        if "|" in line:
            parts = [p.strip() for p in line.split("|")]
            if parts[0].upper() == "JOBID":
                continue
            if len(parts) >= 3:
                jid, start_str, sched_nodes = parts[0], parts[1], parts[2]
                if not target_job_id or jid == target_job_id:
                    info["job_id"] = jid
                    info["start_time"] = start_str
                    info["sched_nodes"] = sched_nodes
                    if len(parts) >= 4:
                        info["reason"] = parts[3]
                    return info
        else:
            tokens = line.split()
            if not tokens or tokens[0].upper() == "JOBID":
                continue
            # Standard `squeue --start`:
            # JOBID PARTITION NAME USER ST START_TIME NODES SCHEDNODES NODELIST(REASON)
            if len(tokens) >= 8:
                jid = tokens[0]
                if not target_job_id or jid == target_job_id:
                    info["job_id"] = jid
                    info["start_time"] = tokens[5]
                    info["sched_nodes"] = tokens[7]
                    if len(tokens) >= 9:
                        info["reason"] = " ".join(tokens[8:])
                    return info
    return info


def parse_squeue_pending(
    output: str,
    target_job_id: str = "",
) -> tuple[list[dict[str, str]], list[str], dict[str, int]]:
    """
    Parse `squeue -p PARTITION -t PENDING` output (either pipe-delimited or
    standard tabular format).

    Returns:
        (inspectable_entries, skipped_array_job_ids, reason_counts)
    """
    inspectable: list[dict[str, str]] = []
    skipped_arrays: list[str] = []
    reason_counts: dict[str, int] = {}

    for raw_line in output.splitlines():
        line = raw_line.strip()
        if not line:
            continue

        if "|" in line:
            parts = [p.strip() for p in line.split("|")]
            if parts[0].upper() == "JOBID":
                continue
            jid = parts[0]
            prio_s = parts[1] if len(parts) > 1 else ""
            user = parts[2] if len(parts) > 2 else ""
            name = parts[3] if len(parts) > 3 else ""
            reason = parts[4].strip("()") if len(parts) > 4 else ""
            start_t = parts[5] if len(parts) > 5 else ""
            sched_n = parts[6] if len(parts) > 6 else ""
        else:
            tokens = line.split()
            if not tokens or tokens[0].upper() == "JOBID":
                continue
            jid = tokens[0]
            prio_s = ""
            name = tokens[2] if len(tokens) > 2 else ""
            user = tokens[3] if len(tokens) > 3 else ""
            reason_raw = tokens[-1] if len(tokens) >= 8 else ""
            reason = reason_raw.strip("()") if reason_raw.startswith("(") else ""
            start_t = ""
            sched_n = ""

        if reason:
            reason_counts[reason] = reason_counts.get(reason, 0) + 1

        if jid == target_job_id:
            continue

        if is_compressed_array_job_id(jid):
            skipped_arrays.append(jid)
            continue

        if jid.isdigit() or re.fullmatch(r"\d+_\d+", jid):
            inspectable.append(
                {
                    "job_id": jid,
                    "priority": prio_s,
                    "user": user,
                    "name": name,
                    "reason": reason,
                    "start_time": start_t,
                    "sched_nodes": sched_n,
                }
            )
        else:
            skipped_arrays.append(jid)

    return inspectable, skipped_arrays, reason_counts


def parse_sacctmgr_accounts(output: str) -> dict[str, str]:
    """
    Parse `sacctmgr show account ... format=Account,ParentName -n -p`
    pipe-delimited output (`Account|ParentName|`) into a mapping of
    child_account_lower -> parent_account_lower.

    Empty ParentName fields (e.g. `immune-rep.prj||`) and self-referential
    entries (`acct == parent`) are ignored so unavailable or incomplete
    hierarchy data is never treated as a valid parent chain.
    """
    parent_map: dict[str, str] = {}
    for line in output.splitlines():
        stripped = line.strip()
        if not stripped:
            continue
        parts = [p.strip() for p in stripped.split("|")]
        if parts and parts[-1] == "":
            parts = parts[:-1]
        if len(parts) == 2:
            acct = parts[0].lower()
            parent = parts[1].lower()
        elif len(parts) >= 3:
            acct = parts[0].lower()
            parent = parts[2].lower() if parts[2] else parts[1].lower()
        else:
            continue
        if acct == "account" and parent in {"parentname", "parent", "org", "descr"}:
            continue
        if acct and parent and parent != acct and not is_null_value(parent):
            parent_map[acct] = parent
    return parent_map


def resolve_account_ancestors(
    account: str,
    parent_map: dict[str, str],
) -> set[str]:
    """
    Return candidate account identifiers for `account`:
        - exact lowercased account name
        - proven ancestors reachable via `parent_map`

    Does not infer parent accounts from string suffixes (such as '.prj').
    """
    if is_null_value(account):
        return set()
    acct_low = account.strip().lower()
    candidates: set[str] = {acct_low}

    curr = acct_low
    visited: set[str] = set()
    while curr and curr not in visited:
        visited.add(curr)
        parent = parent_map.get(curr, "").strip().lower()
        if parent and not is_null_value(parent) and parent != curr:
            candidates.add(parent)
            curr = parent
        else:
            break
    return candidates


_FAILED_DEP_TOKEN_RE = re.compile(r"\(\s*failed\s*\)", re.IGNORECASE)


def find_failed_dependencies(dependency_raw: str | None) -> list[str]:
    """
    Inspect a SLURM Dependency= expression and return any individual
    dependency clauses that explicitly report a `(failed)` state
    (e.g. `afterok:34360405(failed)`).

    Never classifies `(unfulfilled)` or other non-failed states as failed.
    """
    if is_null_value(dependency_raw):
        return []
    assert dependency_raw is not None
    failed_clauses: list[str] = []
    for clause in re.split(r"[,?]+", dependency_raw.strip()):
        tok = clause.strip()
        if tok and _FAILED_DEP_TOKEN_RE.search(tok):
            failed_clauses.append(tok)
    return failed_clauses


