def is_null_value(value: str | None) -> bool:
    if value is None:
        return True
    return value.strip().lower() in NULL_STRINGS


def parse_partition_list(raw: str | None) -> list[str]:
    """
    Parse a SLURM Partition field (single or comma-separated list) into an
    ordered, deduplicated list of partition names.
    """
    if is_null_value(raw):
        return []
    assert raw is not None
    result: list[str] = []
    seen: set[str] = set()
    for part in raw.split(","):
        p = part.strip()
        if p and not is_null_value(p) and p not in seen:
            seen.add(p)
            result.append(p)
    return result


def normalize_node_name(name: str) -> str:
    return name.strip().split(".")[0]


def expand_nodelist(expr: str | None) -> list[str]:
    """
    Expand a SLURM nodelist expression such as 'compg[027,037-038]' into
    individual normalized node names.
    """
    if is_null_value(expr):
        return []
    assert expr is not None
    text = expr.strip()

    # Split on top-level commas (outside square brackets).
    parts: list[str] = []
    current: list[str] = []
    depth = 0
    for ch in text:
        if ch == "[":
            depth += 1
            current.append(ch)
        elif ch == "]":
            depth = max(0, depth - 1)
            current.append(ch)
        elif ch == "," and depth == 0:
            part = "".join(current).strip()
            if part:
                parts.append(part)
            current = []
        else:
            current.append(ch)
    tail = "".join(current).strip()
    if tail:
        parts.append(tail)

    result: list[str] = []
    seen: set[str] = set()

    bracket_re = re.compile(r"^([^\[\]]*)\[([^\[\]]+)\](.*)$")

    def _expand_item(item: str) -> list[str]:
        match = bracket_re.match(item)
        if not match:
            return [normalize_node_name(item)] if item else []
        prefix, inner, suffix = match.groups()
        expanded_prefixes: list[str] = []
        for range_tok in inner.split(","):
            range_tok = range_tok.strip()
            if not range_tok:
                continue
            if "-" in range_tok:
                bounds = range_tok.split("-", 1)
                start_s, end_s = bounds[0].strip(), bounds[1].strip()
                if start_s.isdigit() and end_s.isdigit():
                    width = len(start_s)
                    start_i, end_i = int(start_s), int(end_s)
                    if end_i >= start_i and (end_i - start_i) <= 10000:
                        for num in range(start_i, end_i + 1):
                            expanded_prefixes.append(f"{prefix}{num:0{width}d}")
                    else:
                        expanded_prefixes.append(f"{prefix}{range_tok}")
                else:
                    expanded_prefixes.append(f"{prefix}{range_tok}")
            else:
                expanded_prefixes.append(f"{prefix}{range_tok}")

        out: list[str] = []
        for pref in expanded_prefixes:
            out.extend(_expand_item(f"{pref}{suffix}"))
        return out

    for part in parts:
        for node in _expand_item(part):
            if node and node not in seen:
                seen.add(node)
                result.append(node)

    return result


def format_memory_mb(memory_mb: int | None) -> str:
    if memory_mb is None:
        return "Unknown"
    if memory_mb == 0:
        return "0G"
    if memory_mb % 1024 == 0:
        return f"{memory_mb // 1024}G"
    gb = memory_mb / 1024.0
    if gb >= 10:
        return f"{int(round(gb))}G"
    if gb >= 1:
        return f"{gb:.1f}G"
    return f"{memory_mb}M"


def format_duration_seconds(
    seconds: int | None,
    raw: str | None = None,
    unlimited: bool = False,
) -> str:
    if unlimited or (raw and raw.strip().upper() in {"UNLIMITED", "INFINITE"}):
        return "UNLIMITED"
    if seconds is None:
        return raw if (raw and not is_null_value(raw)) else "Unknown"
    hours, rem = divmod(seconds, 3600)
    minutes, secs = divmod(rem, 60)
    if minutes == 0 and secs == 0 and hours > 0:
        return f"{hours}h"
    if hours >= 24 and seconds % 3600 == 0:
        days, rem_h = divmod(hours, 24)
        if rem_h == 0:
            return f"{days}d ({hours}h)"
        return f"{hours}h"
    if secs == 0:
        return f"{hours}h {minutes}m" if hours > 0 else f"{minutes}m"
    return f"{hours:02d}:{minutes:02d}:{secs:02d}"


def format_datetime(dt: datetime | None, raw: str | None = None) -> str:
    if dt is not None:
        return dt.strftime("%Y-%m-%d %H:%M:%S")
    if raw and not is_null_value(raw):
        return raw
    return "Unknown"


def is_compressed_array_job_id(job_id: str) -> bool:
    """
    Return True for compressed array job expressions like '34290337_[1406-1475%4]'.
    """
    return "[" in job_id or "]" in job_id or "%" in job_id


