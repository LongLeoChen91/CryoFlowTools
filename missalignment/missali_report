#!/apps/strubi/software/packages/miniforge3/envs/miss-alignment/bin/python

"""
missali_report

Summarize alignment-loss results generated by MissAlignment.

The script searches an input directory for *_alignment_loss.json files,
extracts the final alignment loss and number of optimization steps for
each tilt series, sorts the results by final loss from lowest to highest,
and prints a summary table.

Usage:
    missali_report
    missali_report INPUT_DIR
    missali_report INPUT_DIR -o report.txt

Examples:
    missali_report
    missali_report .
    missali_report tiltseries
    missali_report tiltseries -o alignment_loss_report.txt

If INPUT_DIR is omitted, the current directory is used.

Adapted from a script by Pranav Shah.
Maintained by Long Chen.
"""

import json
from pathlib import Path
from typing import Optional

import typer


app = typer.Typer(
    add_completion=False,
    help="Summarize *_alignment_loss.json files generated by MissAlignment.",
)


def json_file2dict(file: Path) -> dict:
    """Load a JSON file and return its contents as a dictionary."""
    with file.open() as js:
        return json.load(js)


@app.command()
def process_alignment_loss(
    input_dir: Path = typer.Argument(
        Path("."),
        exists=True,
        file_okay=False,
        dir_okay=True,
        readable=True,
        help=(
            "Directory containing MissAlignment *_alignment_loss.json files. "
            "Defaults to the current directory."
        ),
    ),
    output_file: Optional[Path] = typer.Option(
        None,
        "--output",
        "-o",
        help="Optional text file path for saving the summary table.",
    ),
):
    """
    Summarize MissAlignment alignment-loss results.

    Finds all *_alignment_loss.json files in INPUT_DIR, extracts the
    tilt-series name, final loss, and number of optimization steps,
    then sorts the tilt series by final loss from lowest to highest.
    """

    jsons = sorted(input_dir.glob("*_alignment_loss.json"))

    if not jsons:
        typer.secho(
            f"No matching *_alignment_loss.json files found in '{input_dir}'",
            fg=typer.colors.RED,
        )
        raise typer.Exit()

    all_data = []

    for jf in jsons:
        try:
            data = json_file2dict(jf)

            all_data.append(
                {
                    "tilt_series": data["tilt_series"],
                    "final_loss": data["final_loss"],
                    "n_optimization_steps": data["n_optimization_steps"],
                }
            )

        except (json.JSONDecodeError, KeyError) as error:
            typer.secho(
                f"Skipping invalid file {jf.name}: {error}",
                fg=typer.colors.YELLOW,
            )

    if not all_data:
        typer.secho(
            "No valid alignment-loss JSON files could be read.",
            fg=typer.colors.RED,
        )
        raise typer.Exit(code=1)

    sorted_data = sorted(
        all_data,
        key=lambda item: item["final_loss"],
    )

    header = (
        f"{'Tilt Series':<25} | "
        f"{'Score (Loss)':>12} | "
        f"{'Steps':>8}"
    )

    divider = "-" * len(header)

    table_lines = [
        header,
        divider,
    ]

    for row in sorted_data:
        line = (
            f"{row['tilt_series']:<25} | "
            f"{row['final_loss']:>12.4f} | "
            f"{row['n_optimization_steps']:>8}"
        )
        table_lines.append(line)

    table_output = "\n".join(table_lines)

    typer.secho(
        "\nAlignment Loss Summary (Sorted by Lowest Score):",
        fg=typer.colors.CYAN,
        bold=True,
    )

    typer.echo(table_output)

    if output_file:
        output_file.write_text(table_output)

        typer.secho(
            f"\nResults saved to: {output_file}",
            fg=typer.colors.GREEN,
            bold=True,
        )


if __name__ == "__main__":
    app()
